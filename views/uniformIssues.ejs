<%- include('header') %>
<style>.issues-page{width:min(100% - 32px,1320px);margin:18px auto 44px}.issues-card{background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:15px;box-shadow:0 2px 8px #0f172a09}.issues-filters{display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:8px;margin-bottom:14px}@media(max-width:850px){.issues-filters{grid-template-columns:1fr}}</style>
<main class="issues-page"><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h4 mb-0">유니폼 지급이력</h1><a class="btn btn-outline-secondary btn-sm" href="/uniform/manage">직원별 관리</a></div><section class="issues-card">
<form class="issues-filters" method="get"><input class="form-control" name="search" value="<%= filters.search %>" placeholder="직원명 또는 사번"><select class="form-select" name="department"><option value="">전체 부서</option><% departments.forEach(function(dept){ %><option value="<%= dept %>" <%= filters.department===dept?'selected':'' %>><%= dept %></option><% }) %></select><select class="form-select" name="issueType"><option value="">전체 구분</option><% ['신규 지급','추가 지급','교환','반납'].forEach(function(type){ %><option value="<%= type %>" <%= filters.issueType===type?'selected':'' %>><%= type %></option><% }) %></select><input class="form-control" type="month" name="month" value="<%= filters.month %>"><button class="btn btn-primary">검색</button></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>지급일</th><th>직원</th><th>부서</th><th>구분</th><th>품목</th><th>처리자</th><th>비고</th></tr></thead><tbody>
<% if(!issues.length){ %><tr><td colspan="7" class="text-center text-muted py-4">지급이력이 없습니다.</td></tr><% } %>
<% issues.forEach(function(issue){ %><tr><td><%= new Date(issue.issuedAt).toISOString().slice(0,10) %></td><td><strong><%= issue.employee ? issue.employee.name : '삭제된 직원' %></strong><br><small><%= issue.employee && issue.employee.empNo || '-' %></small></td><td><%= issue.employee && issue.employee.department || '-' %></td><td><%= issue.issueType %></td><td><% issue.items.forEach(function(item){ %><div><%= item.item %> · <%= item.size||'-' %> · <%= item.quantity %>개</div><% }) %></td><td><%= issue.issuedBy ? issue.issuedBy.username : '-' %></td><td><%= issue.note||'-' %></td></tr><% }) %>
</tbody></table></div></section></main><%- include('footer') %>
