<%- include('header') %>
<style>
.ui-page{max-width:1500px;margin:24px auto 64px;padding:0 22px;color:#172b4d;font-size:.88rem}.ui-head{margin-bottom:16px}.ui-head h1{font-size:1.35rem;margin:0;font-weight:800}.ui-muted{color:#72849a;font-size:.82rem}.ui-card{background:#fff;border:1px solid #dbe4ef;border-radius:12px;box-shadow:0 4px 14px rgba(30,54,87,.06);padding:16px;margin-bottom:15px}.ui-filter{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr auto auto;gap:8px}.ui-filter input,.ui-filter select{min-width:0;border:1px solid #c8d5e5;border-radius:7px;padding:8px 9px;font-size:.84rem}.ui-btn{border:0;border-radius:7px;padding:8px 12px;background:#1769aa;color:#fff;text-decoration:none;font-size:.82rem;font-weight:700}.ui-btn.light{background:#edf2f7;color:#244368}.ui-table-wrap{overflow:auto}.ui-table{width:100%;border-collapse:collapse;white-space:nowrap;font-size:.85rem}.ui-table th,.ui-table td{padding:9px 10px;border-bottom:1px solid #e7edf5;text-align:left}.ui-table th{background:#f5f8fc;color:#45617f;font-size:.78rem}.ui-total{display:flex;gap:10px;margin-bottom:15px}.ui-metric{min-width:180px;background:#fff;border:1px solid #dbe4ef;border-left:3px solid #1769aa;border-radius:10px;padding:13px 15px}.ui-metric span{font-size:.8rem}.ui-metric strong{display:block;font-size:1.15rem;color:#17365d}.ui-empty{text-align:center;padding:34px;color:#72849a}@media(max-width:980px){.ui-filter{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.ui-filter{grid-template-columns:1fr}.ui-total{display:block}.ui-metric{margin-bottom:10px}}
.ui-page{width:calc(100% - 48px);max-width:1280px;padding:0}
</style>
<main class="ui-page">
 <div class="ui-head"><h1>유니폼 지급 관리</h1><div class="ui-muted">전체 직원의 지급 내역을 기간·부서·품목별로 조회합니다.</div></div>
 <% const totalQty=issues.reduce((s,x)=>s+(Number(x.history.quantity)||0),0); %>
 <div class="ui-total"><div class="ui-metric"><span>조회된 지급 건수</span><strong><%= issues.length %>건</strong></div><div class="ui-metric"><span>조회된 지급 수량</span><strong><%= totalQty %>개</strong></div></div>
 <section class="ui-card"><form class="ui-filter" action="/uniform/issues" method="get"><input name="q" value="<%= q %>" placeholder="이름 또는 사번"><select name="department"><option value="">전체 부서</option><% departments.sort().forEach(d=>{ %><option value="<%= d %>" <%= department===d?'selected':'' %>><%= d %></option><% }) %></select><select name="itemKey"><option value="">전체 품목</option><% items.forEach(i=>{ %><option value="<%= i.key %>" <%= itemKey===i.key?'selected':'' %>><%= i.name %></option><% }) %></select><input type="date" name="from" value="<%= from %>" title="시작일"><input type="date" name="to" value="<%= to %>" title="종료일"><button class="ui-btn">검색</button><a class="ui-btn light" href="/uniform/issues">초기화</a></form></section>
 <section class="ui-card ui-table-wrap"><table class="ui-table"><thead><tr><th>지급일</th><th>사번</th><th>직원</th><th>부서</th><th>품목</th><th>사이즈</th><th>수량</th><th>비고</th><th>관리</th></tr></thead><tbody><% issues.forEach(x=>{ %><tr><td><%= new Date(x.history.issuedAt).toLocaleDateString('ko-KR') %></td><td><%= x.employee.empNo||'-' %></td><td><strong><%= x.employee.name %></strong></td><td><%= x.employee.department||'-' %></td><td><%= x.history.itemName %></td><td><%= x.history.size||'-' %></td><td><%= x.history.quantity %></td><td><%= x.history.note||'-' %></td><td><a class="ui-btn light" href="/uniform/<%= x.employee._id %>">상세</a></td></tr><% }) %></tbody></table><% if(!issues.length){ %><div class="ui-empty">조건에 맞는 지급 이력이 없습니다.</div><% } %></section>
</main>
<%- include('footer') %>
