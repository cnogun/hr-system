<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>직원정보관리</title>
<style>
.hr-form-page{width:min(100% - 32px,1240px);margin:16px auto 44px;color:#14243c;font-size:13px;line-height:1.4}.hr-form-page h1{font-size:21px;font-weight:750;margin:0 0 4px}.hr-form-page .hint{color:#64748b;margin:0 0 8px}.hr-card{background:white;border:1px solid #e2e8f0;border-radius:10px;margin:10px 0;overflow:hidden;box-shadow:0 2px 8px #0f172a09}.hr-card h2{font-size:15px;font-weight:700;margin:0;padding:12px 15px 0}.hr-grid{padding:11px 15px 14px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px 10px}.hr-basic-fields{grid-template-columns:repeat(6,minmax(0,1fr))}.hr-contact-grid{grid-template-columns:repeat(6,minmax(0,1fr))}.hr-military-grid{grid-template-columns:repeat(5,minmax(0,1fr))}.hr-account-card{display:grid;grid-template-columns:150px minmax(0,1fr);align-items:center;padding:10px 15px;gap:12px}.hr-account-card h2{padding:0;white-space:nowrap}.hr-account-card .hr-grid{grid-template-columns:1.35fr 1fr;padding:0}.hr-field label{display:block;font-weight:650;font-size:12px;margin-bottom:4px}.hr-field input,.hr-field select,.hr-field textarea{width:100%;min-height:34px;padding:5px 8px;border:1px solid #cbd5e1;border-radius:7px;background:white;color:#14243c;font-size:12px;line-height:1.35}.hr-field input[readonly]{background:#f8fafc}.hr-field textarea{min-height:68px}.hr-wide{grid-column:1/-1}.hr-actions{display:flex;justify-content:flex-end;gap:8px;margin:14px 0}.hr-actions .btn{padding:7px 16px}.hr-help{font-size:11px;color:#64748b}.hr-choice{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:8px 0}.hr-choice a{padding:7px 12px;border-radius:7px;border:1px solid #cbd5e1;text-decoration:none;font-size:13px}.hr-choice a.current{background:#eff6ff;border-color:#2563eb;font-weight:700}.hr-picker{display:grid;grid-template-columns:auto minmax(260px,1fr);align-items:center;gap:12px;padding:13px 15px}.hr-picker h2{padding:0;white-space:nowrap}.hr-picker .hr-field label{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.hr-basic-layout{display:grid;grid-template-columns:135px minmax(0,1fr);gap:14px;padding:11px 15px 14px}.hr-basic-layout>.hr-grid{padding:0}.hr-photo{padding-right:13px;border-right:1px solid #e2e8f0;text-align:center}.hr-photo-preview{width:92px;height:116px;margin:0 auto 8px;border:1px solid #dbe3f0;border-radius:8px;background:#eef2ff;display:grid;place-items:center;overflow:hidden;color:#64748b;font-size:12px}.hr-photo-preview img{width:100%;height:100%;object-fit:cover}.hr-photo input{width:100%;font-size:11px;padding:4px}.hr-photo .hr-help{display:block;margin-top:5px}.hr-form-page details summary{cursor:pointer;font-weight:700;padding:11px 15px}.hr-form-page details[open] summary{border-bottom:1px solid #e2e8f0}.hr-form-page .required{color:#dc2626}@media(max-width:1100px){.hr-basic-fields,.hr-contact-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.hr-military-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:650px){.hr-picker,.hr-account-card{grid-template-columns:1fr;gap:7px}.hr-account-card .hr-grid{grid-template-columns:1fr}.hr-basic-layout{grid-template-columns:1fr;padding:12px}.hr-photo{padding:0 0 12px;border-right:0;border-bottom:1px solid #e2e8f0;display:grid;grid-template-columns:76px minmax(0,1fr);gap:10px;align-items:center;text-align:left}.hr-photo-preview{width:76px;height:92px;margin:0;grid-row:1/span 2}.hr-grid,.hr-basic-fields,.hr-contact-grid,.hr-military-grid{grid-template-columns:1fr;padding:12px}.hr-basic-layout>.hr-grid{padding:0}.hr-wide{grid-column:auto}}
.hr-form-page details summary{display:flex;align-items:center;justify-content:space-between;gap:12px;list-style:none}.hr-form-page details summary::-webkit-details-marker{display:none}.hr-form-page details summary::after{content:'열기';font-size:11px;font-weight:600;color:#2563eb}.hr-form-page details[open] summary::after{content:'닫기'}.hr-title-row{display:flex;align-items:center;gap:10px}.hr-title-row .hr-required-note{font-size:11px;color:#64748b}.hr-basic-layout{grid-template-columns:210px minmax(0,1fr)}.hr-photo-preview{width:118px;height:148px}.hr-photo-empno{margin:7px 0;padding:6px 8px;border-radius:7px;background:#eef2ff;color:#475569;font-size:11px}.hr-photo-empno strong{display:block;margin-top:2px;color:#14243c;font-size:12px}.hr-photo-account{margin-top:11px;padding-top:10px;border-top:1px solid #e2e8f0;text-align:left}.hr-photo-account select{font-size:11px}.hr-address-new,.hr-address-edit{grid-column:span 2}.hr-career-grid{grid-template-columns:repeat(3,minmax(0,1fr))}@media(max-width:1100px){.hr-address-new,.hr-address-edit{grid-column:span 3}}@media(max-width:650px){.hr-basic-layout{grid-template-columns:1fr}.hr-photo-preview{width:84px;height:106px}.hr-photo-account{grid-column:1/-1;margin-top:4px}.hr-address-new,.hr-address-edit{grid-column:auto}.hr-career-grid{grid-template-columns:1fr}}
</style></head><body><%- include('header') %>
<% const editing = typeof employee !== 'undefined' && employee != null; const e = editing ? employee : {}; const choosing = !editing && typeof mode !== 'undefined' && mode === 'existing'; %>
<% const v = (key) => e[key] == null ? '' : String(e[key]); %>
<% const dateValue = (key) => e[key] ? (e[key] instanceof Date ? e[key].toISOString().slice(0,10) : String(e[key]).slice(0,10)) : ''; %>
<main class="hr-form-page"><div class="hr-title-row"><h1>직원정보관리</h1><span class="hr-required-note"><span class="required">*</span> 필수 항목</span></div>
<div class="hr-choice"><a href="/employees/manage" class="<%= !editing && !choosing ? 'current' : '' %>">신규 등록</a><a href="/employees/manage?mode=existing" class="<%= editing || choosing ? 'current' : '' %>">직원 정보 수정</a></div>
<% if (editing || choosing) { %><section class="hr-card hr-picker" id="choose"><h2>직원 정보 수정</h2><div class="hr-field"><label for="pickEmployee">수정할 직원</label><select id="pickEmployee" onchange="if(this.value) location.href='/employees/'+encodeURIComponent(this.value)+'/edit'"><option value="">수정할 직원을 선택하세요</option><% (typeof employees !== 'undefined' ? employees : []).forEach(function(item){ %><option value="<%= item._id %>" <%= editing && String(item._id)===String(e._id) ? 'selected' : '' %>><%= item.name %> (<%= item.empNo || '-' %> · <%= item.department || '-' %>)</option><% }) %></select></div></section><% } %>
<% if (!choosing) { %>
<form id="employeeForm" action="<%= editing ? '/employees/'+e._id+'?_method=PUT' : '/admin/employees/new' %>" method="POST" enctype="multipart/form-data">
<section class="hr-card"><h2>기본 정보</h2><div class="hr-basic-layout"><div class="hr-photo"><div class="hr-photo-preview" id="profileImagePreview"><% if(editing && e.profileImage){ %><img src="<%= e.profileImage %>" alt="현재 프로필 사진"><% } else { %><span>사진 없음</span><% } %></div><% if(editing){ %><div class="hr-photo-empno">사번<strong><%= v('empNo') %></strong></div><% } %><input id="profileImage" type="file" name="profileImage" accept="image/jpeg,image/png,image/gif"><small class="hr-help">JPG, PNG, GIF</small><% if (!editing) { %><div class="hr-field hr-photo-account"><label for="userId">연결 계정 <span class="required">*</span></label><select name="userId" id="userId" required><option value="">사용자 계정 선택</option><% (typeof users !== 'undefined' ? users : []).forEach(function(u){ %><option value="<%= u._id %>" data-email="<%= u.email %>"><%= u.username %> (<%= u.email %>)</option><% }) %></select><small class="hr-help">계정이 없다면 먼저 일반 사용자 계정을 생성하세요.</small></div><% } %></div><div class="hr-grid hr-basic-fields">
<div class="hr-field"><label for="f_name">이름 <span class="required">*</span></label><input id="f_name" name="name" type="text" value="<%= v('name') %>" required></div>
<div class="hr-field"><label for="f_hireDate">입사일 <span class="required">*</span></label><input id="f_hireDate" name="hireDate" type="date" value="<%= dateValue('hireDate') %>" required></div>
<div class="hr-field"><label for="f_orgType">소속 <span class="required">*</span></label><select id="f_orgType" name="orgType" required><option value="">선택</option><% if (editing && v('orgType') && !['본사','지사'].includes(v('orgType'))) { %><option value="<%= v('orgType') %>" selected><%= v('orgType') %> (기존 소속)</option><% } %><option value="본사" <%= v('orgType') === '본사' ? 'selected' : '' %>>본사</option><option value="지사" <%= v('orgType') === '지사' ? 'selected' : '' %>>지사</option></select></div>
<div class="hr-field"><label for="f_department">부서 <span class="required">*</span></label><select id="f_department" name="department" required><option value="">선택</option><option value="보안1팀" <%= v('department') === '보안1팀' ? 'selected' : '' %>>보안1팀</option><option value="보안2팀" <%= v('department') === '보안2팀' ? 'selected' : '' %>>보안2팀</option><option value="보안3팀" <%= v('department') === '보안3팀' ? 'selected' : '' %>>보안3팀</option><option value="관리팀" <%= v('department') === '관리팀' ? 'selected' : '' %>>관리팀</option><option value="인사팀" <%= v('department') === '인사팀' ? 'selected' : '' %>>인사팀</option><option value="영업팀" <%= v('department') === '영업팀' ? 'selected' : '' %>>영업팀</option><option value="지원팀" <%= v('department') === '지원팀' ? 'selected' : '' %>>지원팀</option></select></div>
<div class="hr-field"><label for="f_position">직급</label><select id="f_position" name="position"><option value="">선택</option><option value="인턴" <%= v('position') === '인턴' ? 'selected' : '' %>>인턴</option><option value="사원" <%= v('position') === '사원' ? 'selected' : '' %>>사원</option><option value="주임" <%= v('position') === '주임' ? 'selected' : '' %>>주임</option><option value="대리" <%= v('position') === '대리' ? 'selected' : '' %>>대리</option><option value="과장" <%= v('position') === '과장' ? 'selected' : '' %>>과장</option><option value="차장" <%= v('position') === '차장' ? 'selected' : '' %>>차장</option><option value="팀장" <%= v('position') === '팀장' ? 'selected' : '' %>>팀장</option><option value="실장" <%= v('position') === '실장' ? 'selected' : '' %>>실장</option><option value="임원" <%= v('position') === '임원' ? 'selected' : '' %>>임원</option></select></div>
<div class="hr-field"><label for="f_employmentType">고용형태</label><select id="f_employmentType" name="employmentType"><option value="">선택</option><option value="정규직" <%= v('employmentType') === '정규직' ? 'selected' : '' %>>정규직</option><option value="파견직" <%= v('employmentType') === '파견직' ? 'selected' : '' %>>파견직</option><option value="계약직" <%= v('employmentType') === '계약직' ? 'selected' : '' %>>계약직</option></select></div>
<div class="hr-field"><label for="f_birth">생년월일</label><input id="f_birth" name="birth" type="date" value="<%= dateValue('birth') %>"></div>
<div class="hr-field"><label for="f_mobile">휴대폰</label><input id="f_mobile" name="mobile" type="tel" value="<%= v('mobile') %>"></div>
<% if (!editing) { %><div class="hr-field"><label for="accountEmail">이메일</label><input id="accountEmail" name="email" type="email" readonly required></div><% } else { %><div class="hr-field"><label for="email">이메일 <span class="required">*</span></label><input id="email" name="email" type="email" value="<%= v('email') %>" required></div><% } %>
<div class="hr-field"><label for="f_gender">성별</label><select id="f_gender" name="gender"><option value="">선택</option><option value="남" <%= v('gender') === '남' ? 'selected' : '' %>>남</option><option value="여" <%= v('gender') === '여' ? 'selected' : '' %>>여</option></select></div>
<div class="hr-field"><label for="f_nationality">국적</label><input id="f_nationality" name="nationality" type="text" value="<%= v('nationality') %>"></div>
<div class="hr-field"><label for="f_education">학력</label><input id="f_education" name="education" type="text" value="<%= v('education') %>"></div>
<div class="hr-field <%= editing ? 'hr-address-edit' : 'hr-address-new' %>"><label for="f_address">주소</label><input id="f_address" name="address" type="text" value="<%= v('address') %>"></div>
<div class="hr-field"><label for="f_height">신장(cm)</label><input id="f_height" name="height" type="number" value="<%= v('height') %>" step="any"></div>
<div class="hr-field"><label for="f_weight">체중(kg)</label><input id="f_weight" name="weight" type="number" value="<%= v('weight') %>" step="any"></div>
<div class="hr-field"><label for="f_bloodType">혈액형</label><input id="f_bloodType" name="bloodType" type="text" value="<%= v('bloodType') %>"></div>
<div class="hr-field"><label for="f_status">재직 상태</label><select id="f_status" name="status"><option value="">선택</option><option value="재직" <%= !editing || v('status') === '재직' ? 'selected' : '' %>>재직</option><option value="휴직" <%= v('status') === '휴직' ? 'selected' : '' %>>휴직</option><option value="퇴직" <%= v('status') === '퇴직' ? 'selected' : '' %>>퇴직</option></select></div>
<input type="hidden" name="phone" value="<%= v('phone') %>">
<input type="hidden" name="emergencyContact" value="<%= v('emergencyContact') %>">
<% if(editing){ %><input type="hidden" name="cap" value="<%= v('cap') %>"><input type="hidden" name="capQty" value="<%= v('capQty') %>"><input type="hidden" name="uniformSummerTop" value="<%= v('uniformSummerTop') %>"><input type="hidden" name="uniformSummerTopQty" value="<%= v('uniformSummerTopQty') %>"><input type="hidden" name="uniformSummerBottom" value="<%= v('uniformSummerBottom') %>"><input type="hidden" name="uniformSummerBottomQty" value="<%= v('uniformSummerBottomQty') %>"><input type="hidden" name="uniformWinterTop" value="<%= v('uniformWinterTop') %>"><input type="hidden" name="uniformWinterTopQty" value="<%= v('uniformWinterTopQty') %>"><input type="hidden" name="uniformWinterBottom" value="<%= v('uniformWinterBottom') %>"><input type="hidden" name="uniformWinterBottomQty" value="<%= v('uniformWinterBottomQty') %>"><input type="hidden" name="uniformWinterPants" value="<%= v('uniformWinterPants') %>"><input type="hidden" name="uniformWinterPantsQty" value="<%= v('uniformWinterPantsQty') %>"><input type="hidden" name="uniformWinterCoat" value="<%= v('uniformWinterCoat') %>"><input type="hidden" name="uniformWinterCoatQty" value="<%= v('uniformWinterCoatQty') %>"><input type="hidden" name="springAutumnUniform" value="<%= v('springAutumnUniform') %>"><input type="hidden" name="springAutumnUniformQty" value="<%= v('springAutumnUniformQty') %>"><input type="hidden" name="raincoat" value="<%= v('raincoat') %>"><input type="hidden" name="raincoatQty" value="<%= v('raincoatQty') %>"><input type="hidden" name="safetyShoes" value="<%= v('safetyShoes') %>"><input type="hidden" name="safetyShoesQty" value="<%= v('safetyShoesQty') %>"><input type="hidden" name="rainBoots" value="<%= v('rainBoots') %>"><input type="hidden" name="rainBootsQty" value="<%= v('rainBootsQty') %>"><input type="hidden" name="winterJacket" value="<%= v('winterJacket') %>"><input type="hidden" name="winterJacketQty" value="<%= v('winterJacketQty') %>"><input type="hidden" name="doubleJacket" value="<%= v('doubleJacket') %>"><input type="hidden" name="doubleJacketQty" value="<%= v('doubleJacketQty') %>"><% } %>
</div></div></section>
<details class="hr-card"><summary>병역 사항</summary><div class="hr-grid hr-military-grid">
<div class="hr-field"><label for="f_militaryBranch">군별</label><input id="f_militaryBranch" name="militaryBranch" type="text" value="<%= v('militaryBranch') %>"></div>
<div class="hr-field"><label for="f_militaryRank">계급</label><input id="f_militaryRank" name="militaryRank" type="text" value="<%= v('militaryRank') %>"></div>
<div class="hr-field"><label for="f_militaryNumber">군번</label><input id="f_militaryNumber" name="militaryNumber" type="text" value="<%= v('militaryNumber') %>"></div>
<div class="hr-field"><label for="f_militaryServicePeriod">복무기간</label><input id="f_militaryServicePeriod" name="militaryServicePeriod" type="text" value="<%= v('militaryServicePeriod') %>"></div>
<div class="hr-field"><label for="f_militaryExemptionReason">미필·면제 사유</label><input id="f_militaryExemptionReason" name="militaryExemptionReason" type="text" value="<%= v('militaryExemptionReason') %>"></div>
</div></details>
<details class="hr-card"><summary>경력/자격/특이사항</summary><div class="hr-grid hr-career-grid">
<div class="hr-field"><label for="f_career">경력사항</label><textarea id="f_career" name="career" maxlength="2000"><%= v('career') %></textarea></div>
<div class="hr-field"><label for="f_qualifications">자격사항</label><textarea id="f_qualifications" name="qualifications" maxlength="1000"><%= v('qualifications') %></textarea></div>
<div class="hr-field"><label for="f_specialNotes">특이사항</label><textarea id="f_specialNotes" name="specialNotes" maxlength="1000"><%= v('specialNotes') %></textarea></div>
</div></details>
<details class="hr-card"><summary>급여 정보</summary><div class="hr-grid">
<div class="hr-field"><label for="f_salaryBank">급여 은행</label><input id="f_salaryBank" name="salaryBank" type="text" value="<%= v('salaryBank') %>"></div>
<div class="hr-field"><label for="f_salaryAccount">급여 계좌</label><input id="f_salaryAccount" name="salaryAccount" type="text" value="<%= v('salaryAccount') %>"></div>
</div></details>
<div class="hr-actions"><a class="btn btn-outline-secondary" href="/employees">취소</a><button class="btn btn-primary" type="submit"><%= editing ? '변경사항 저장' : '직원 등록' %></button></div></form><% } %></main><%- include('footer') %>
<script>
const account=document.getElementById('userId');if(account){const sync=()=>{document.getElementById('accountEmail').value=account.selectedOptions[0]?.dataset.email||''};account.addEventListener('change',sync);sync()}
const profileImage=document.getElementById('profileImage'),profileImagePreview=document.getElementById('profileImagePreview');if(profileImage&&profileImagePreview){profileImage.addEventListener('change',()=>{const file=profileImage.files&&profileImage.files[0];if(!file)return;const reader=new FileReader();reader.addEventListener('load',()=>{const image=document.createElement('img');image.src=reader.result;image.alt='선택한 프로필 사진';profileImagePreview.replaceChildren(image)});reader.readAsDataURL(file)})}
</script></body></html>
