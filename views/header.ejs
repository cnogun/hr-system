    { label: '월간 근태현황', href: '/monthlyAttendance', admin: true },
    { label: '근무 스케줄', href: '/workSchedule', admin: true }
  ] },
  { id: 'payroll', label: '급여관리', icon: 'fa-wallet', items: [], upcoming: true },
  { id: 'work-info', label: '보안업무', icon: 'fa-briefcase', items: [
    { label: '근무명령서', href: '/work-orders', admin: true },
    { label: '인계사항', href: '/handovers', admin: true },
    { label: '지시사항', href: '/security/duty-orders', admin: true },
    { label: '보고서', href: '/security/summary-reports', admin: true }
  ] },
  { id: 'community', label: '커뮤니티', icon: 'fa-comments', items: [
    { label: '자유게시판', href: '/boards' },
    { label: '게시판 신고 관리', href: '/boards/admin/reports', admin: true }
  ] },
  { id: 'system', label: '시스템정보', icon: 'fa-gear', items: [
    { label: '시스템알림', href: '/notice' },


    { label: '통합 엑셀 관리', href: '/excelManager', admin: true },
    { label: '활동 로그 관리', href: '/auth/logs', admin: true }
  ] }
] : [
  { id: 'home', label: '내 페이지', icon: 'fa-house-user', items: [
    { label: '내 정보', href: '/my' }
  ] },
  { id: 'people', label: '인사정보', icon: 'fa-users', items: [
    { label: '직원찾기', href: '/directory' }
  ] },
  { id: 'work-info', label: '보안업무', icon: 'fa-briefcase', items: [
    { label: '근무명령서', href: '/work-orders' },
    { label: '인계사항', href: '/handovers' },
    { label: '지시사항', href: '/security/duty-orders' },
    { label: '보고서', href: '/security/summary-reports' }
  ] },
  { id: 'uniform', label: '유니폼', icon: 'fa-shirt', items: [
    { label: '내 유니폼', href: '/uniform' }
  ] },
  { id: 'community', label: '커뮤니티', icon: 'fa-comments', items: [
    { label: '자유게시판', href: '/boards' }
  ] },
  { id: 'system', label: '시스템정보', icon: 'fa-gear', items: [
