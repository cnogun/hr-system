<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="/mobile-optimization.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<style>
  :root { --hr-side: 228px; --hr-navy: #14243c; --hr-blue: #2563eb; --hr-bg: #f4f6f9; --hr-border: #e2e8f0; --hr-text: #1e293b; }
  body { background: var(--hr-bg); color: var(--hr-text); min-height: 100vh; display: flex; flex-direction: column; }
  <% if (hrLoggedIn) { %>
  body { padding-left: var(--hr-side); }
  <% } %>
  .hr-header { background: #fff; position: sticky; top: 0; z-index: 1030; border-bottom: 1px solid var(--hr-border); box-shadow: 0 2px 12px rgba(15, 23, 42, .05); flex-shrink: 0; }
  .hr-topbar { min-height: 66px; padding: 0 26px; display: flex; align-items: center; gap: 16px; }
  .hr-page-label { min-width: 0; flex: 1; }
  .hr-page-label strong { display: block; font-size: 1rem; line-height: 1.3; color: var(--hr-text); }
  .hr-page-label small { color: #64748b; font-size: .75rem; }
  .hr-actions { display: flex; align-items: center; gap: 12px; }
  .hr-user { display: flex; flex-direction: column; align-items: flex-end; max-width: 180px; line-height: 1.3; }
  .hr-user strong, .hr-user small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
  .hr-user strong { font-size: .84rem; }
  .hr-user small { font-size: .74rem; color: #64748b; }
  .hr-logout { color: #475569; border: 1px solid var(--hr-border); border-radius: 8px; font-size: .8rem; white-space: nowrap; }
  .hr-logout:hover { background: #eff6ff; color: #1d4ed8; border-color: #bfdbfe; }
  .hr-menu-toggle, .hr-menu-close { display: none; background: #fff; color: var(--hr-text); border: 1px solid var(--hr-border); border-radius: 8px; width: 38px; height: 38px; align-items: center; justify-content: center; }
  .hr-subbar { min-height: 51px; padding: 0 26px; display: flex; align-items: center; border-top: 1px solid #eef2f7; }
  .hr-submenu { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; padding: 6px 0; }
  .hr-submenu[hidden] { display: none !important; }
  .hr-submenu a { display: inline-flex; align-items: center; min-height: 34px; padding: 7px 12px; border-radius: 7px; font-size: .84rem; font-weight: 550; color: #475569; text-decoration: none; white-space: nowrap; }
  .hr-submenu a:hover, .hr-submenu a:focus-visible { background: #eff6ff; color: #1d4ed8; }
  .hr-submenu a.active { background: #eaf2ff; color: #1d4ed8; font-weight: 700; }
  .hr-empty { font-size: .83rem; color: #64748b; margin: 0; padding: 7px 0; }
  .hr-sidebar { width: var(--hr-side); position: fixed; left: 0; top: 0; bottom: 0; z-index: 1040; background: var(--hr-navy); color: #fff; display: flex; flex-direction: column; box-shadow: 3px 0 14px rgba(15, 23, 42, .12); }
  .hr-brand { min-height: 82px; padding: 18px 16px; display: flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; }
  .hr-brand:hover, .hr-brand:focus { color: #fff; }
  .hr-brand-icon { flex: 0 0 36px; height: 36px; display: grid; place-items: center; background: #315783; border-radius: 9px; }
  .hr-brand strong { display: block; font-size: .87rem; white-space: nowrap; }
  .hr-brand small { display: block; font-size: .68rem; color: #aebed2; }
  .hr-main-nav { overflow-y: auto; flex: 1; padding: 10px 10px 18px; }
  .hr-nav-caption { margin: 5px 11px 10px; font-size: .68rem; letter-spacing: .08em; color: #93a9c4; }
  .hr-main-link { display: flex; align-items: center; width: 100%; gap: 12px; padding: 11px 12px; margin: 3px 0; border: 0; border-radius: 8px; background: transparent; color: #cbd6e5; text-align: left; font-size: .89rem; font-weight: 550; cursor: pointer; }
  .hr-main-link:hover, .hr-main-link:focus-visible { background: #223754; color: #fff; }
  .hr-main-link.active { background: #315783; color: #fff; font-weight: 700; }
  .hr-main-link i { width: 18px; text-align: center; }
  .hr-main-link span { flex: 1; }
  .hr-main-link .hr-soon { font-size: .65rem; color: #b7c7dd; font-weight: 400; }
  .hr-side-foot { padding: 15px 20px; border-top: 1px solid #324761; color: #93a9c4; font-size: .7rem; }
  .hr-backdrop { display: none; }
  .hr-guest-brand { font-size: 1rem; font-weight: 700; text-decoration: none; color: var(--hr-navy); flex: 1; }
  @media (max-width: 991.98px) {
    body { padding-left: 0; }
    .hr-menu-toggle, .hr-menu-close { display: inline-flex; }
    .hr-menu-close { margin-left: auto; flex: 0 0 38px; }
    .hr-sidebar { transform: translateX(-100%); transition: transform .2s ease; }
    .hr-sidebar.is-open { transform: translateX(0); }
    .hr-backdrop.is-open { display: block; position: fixed; inset: 0; z-index: 1035; border: 0; background: rgba(15, 23, 42, .52); }
    .hr-topbar { padding: 0 16px; }
    .hr-subbar { padding: 0 16px; overflow-x: auto; }
    .hr-submenu { flex-wrap: nowrap; min-width: max-content; }
    body.hr-menu-open { overflow: hidden; }
  }
  @media (max-width: 575.98px) {
    .hr-topbar { min-height: 58px; gap: 9px; }
    .hr-page-label strong { font-size: .91rem; }
    .hr-page-label small, .hr-user { display: none; }
    .hr-logout { padding: 7px 9px; }
    .hr-logout span { display: none; }
  }
  @media print {
    body { padding-left: 0 !important; }
    .hr-header, .hr-sidebar, .hr-backdrop { display: none !important; }
  }
</style>
<% if (hrLoggedIn) { %>
<aside class="hr-sidebar" id="hrSidebar" aria-label="주 메뉴">
  <div class="hr-brand">
    <span class="hr-brand-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
    <span><strong>보안근무 관리 시스템</strong><small>Security Work Management</small></span>
    <button class="hr-menu-close" type="button" aria-label="메뉴 닫기"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
  </div>
  <nav class="hr-main-nav" aria-label="업무 구분">
    <p class="hr-nav-caption">WORKSPACE</p>
    <% hrGroups.forEach(function(group) { %>
      <button class="hr-main-link" type="button" data-hr-group="<%= group.id %>" aria-controls="hrSubmenu-<%= group.id %>" aria-pressed="false">
        <i class="fa-solid <%= group.icon %>" aria-hidden="true"></i><span><%= group.label %></span>
        <% if (group.upcoming) { %><small class="hr-soon">준비 중</small><% } %>
      </button>
    <% }); %>
  </nav>
  <div class="hr-side-foot">© 보안근무 관리 시스템</div>
</aside>
<button class="hr-backdrop" type="button" aria-label="메뉴 닫기"></button>
<% } %>
<header class="hr-header">
  <div class="hr-topbar">
    <% if (hrLoggedIn) { %>
      <button class="hr-menu-toggle" type="button" aria-controls="hrSidebar" aria-expanded="false" aria-label="주 메뉴 열기"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
      <div class="hr-page-label"><strong id="hrCategoryTitle">대시보드</strong></div>
      <div class="hr-actions">
        <div class="hr-user"><strong><%= hrName %></strong><small><%= hrPosition || (hrAdmin ? '관리자' : '사용자') %></small></div>
        <a class="btn btn-sm hr-logout" href="/auth/logout" aria-label="로그아웃"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i><span class="ms-1">로그아웃</span></a>
      </div>
    <% } else { %>
      <a class="hr-guest-brand" href="/auth/login"><i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>보안근무 관리 시스템</a>
      <a class="btn btn-primary btn-sm" href="/auth/login">로그인</a>
      <a class="btn btn-outline-secondary btn-sm" href="/auth/register">회원가입</a>
    <% } %>
  </div>
  <% if (hrLoggedIn) { %>
  <div class="hr-subbar" aria-label="하위 메뉴">
    <% hrGroups.forEach(function(group) { %>
      <nav class="hr-submenu" id="hrSubmenu-<%= group.id %>" data-hr-panel="<%= group.id %>" aria-label="<%= group.label %> 하위 메뉴" hidden>
        <% const visibleItems = group.items.filter(function(item) { return !item.admin || hrAdmin; }); %>
        <% if (group.upcoming) { %>
          <p class="hr-empty">급여관리 기능은 준비 중입니다.</p>
        <% } else if (visibleItems.length === 0) { %>
          <p class="hr-empty">관리자 권한이 필요한 메뉴입니다.</p>
        <% } else { %>
          <% visibleItems.forEach(function(item) { %><a href="<%= item.href %>"><%= item.label %></a><% }); %>
        <% } %>
      </nav>
    <% }); %>
  </div>
  <% } %>
</header>
<% if (hrLoggedIn) { %>
<script>
  (function () {
    function ready() {
      const sidebar = document.getElementById('hrSidebar');
      const buttons = Array.from(sidebar.querySelectorAll('[data-hr-group]'));
      const panels = Array.from(document.querySelectorAll('[data-hr-panel]'));
      const title = document.getElementById('hrCategoryTitle');
      const toggle = document.querySelector('.hr-menu-toggle');
      const backdrop = document.querySelector('.hr-backdrop');
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      const links = panels.flatMap(panel => Array.from(panel.querySelectorAll('a[href]')));
      const exact = links.find(link => link.getAttribute('href') === path);
      const match = exact || links.filter(link => {
        const href = link.getAttribute('href');
        return href !== '/dashboard' && path.startsWith(href + '/');
      }).sort((a, b) => b.getAttribute('href').length - a.getAttribute('href').length)[0];
      function closeSidebar() {
        sidebar.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        document.body.classList.remove('hr-menu-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
      function selectGroup(id) {
        buttons.forEach(button => {
          const selected = button.dataset.hrGroup === id;
          button.classList.toggle('active', selected);
          button.setAttribute('aria-pressed', String(selected));
          if (selected) title.textContent = button.querySelector('span').textContent;
        });
        panels.forEach(panel => { panel.hidden = panel.dataset.hrPanel !== id; });
        closeSidebar();
      }
      if (match) {
        match.classList.add('active');
        match.setAttribute('aria-current', 'page');
      }
      // 직원 상세정보 화면은 인사정보 메뉴에 속함
const isEmployeeDetail = /^\/admin\/employees\/[^/]+$/.test(path) || /^\/employees\/[^/]+\/edit$/.test(path);

const activeGroup = isEmployeeDetail
  ? 'people'
  : (match ? match.closest('[data-hr-panel]').dataset.hrPanel : 'home');

selectGroup(activeGroup);
      
buttons.forEach(button => {
  button.addEventListener('click', () => {
    const groupId = button.dataset.hrGroup;

    // 선택한 메뉴의 하위 메뉴 찾기
    const panel = panels.find(
      panel => panel.dataset.hrPanel === groupId
    );

    if (!panel) return;

    // 실제 접근 가능한 첫 번째 페이지 찾기
    const firstLink = panel.querySelector('a[href]');

    // 준비 중인 메뉴는 기존 동작 유지
    if (!firstLink) {
      selectGroup(groupId);
      return;
    }

    // 실제 페이지 이동
    const target = firstLink.getAttribute('href');

    if (window.location.pathname === target) {
      selectGroup(groupId);
      return;
    }

    window.location.assign(target);
  });
});
      toggle.addEventListener('click', () => {
        const open = !sidebar.classList.contains('is-open');
        sidebar.classList.toggle('is-open', open);
        backdrop.classList.toggle('is-open', open);
        document.body.classList.toggle('hr-menu-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
      backdrop.addEventListener('click', closeSidebar);
      sidebar.querySelector('.hr-menu-close').addEventListener('click', closeSidebar);
      document.addEventListener('keydown', event => { if (event.key === 'Escape') closeSidebar(); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ready);
    else ready();
  })();
</script>
<% } %>
<script>
  function hrToast(message, tone, delay) {
    const container = createToastContainer();
    const toast = document.createElement('div');
    toast.className = 'toast show text-white bg-' + tone;
    const body = document.createElement('div');
    body.className = 'toast-body';
    body.textContent = String(message);
    toast.appendChild(body);
    container.appendChild(toast);
    if (delay) window.setTimeout(() => toast.remove(), delay);
    return toast;
  }
  function createToastContainer() {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'toast-container position-fixed top-0 end-0 p-3';
      container.style.zIndex = '1090';
      document.body.appendChild(container);
    }
    return container;
  }
  function showLoadingToast(message) { return hrToast(message, 'info', 0); }
  function hideLoadingToast(toast) { if (toast) toast.remove(); }
  function showSuccessToast(message) { return hrToast(message, 'success', 3000); }
  function showErrorToast(message) { return hrToast(message, 'danger', 5000); }
</script>
