<% const hrSession = typeof session !== 'undefined' ? session : null; %>
<% const hrLoggedIn = Boolean(hrSession && hrSession.userId); %>
<% const hrAdmin = hrLoggedIn && (hrSession.userRole === 'admin' || (typeof userRole !== 'undefined' && userRole === 'admin')); %>
<% const hrName = typeof name !== 'undefined' && name ? name : (hrSession && hrSession.name ? hrSession.name : (hrAdmin ? '관리자' : '사용자')); %>
<% const hrPosition = typeof position !== 'undefined' && position ? position : (hrSession && hrSession.position ? hrSession.position : ''); %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="/mobile-optimization.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<style>
  :root { --hr-navy: #14243c; --hr-navy-light: #223754; --hr-blue: #2563eb; --hr-surface: #fff; --hr-bg: #f4f6f9; --hr-border: #e2e8f0; --hr-text: #1e293b; }
  body { background: var(--hr-bg); min-height: 100vh; color: var(--hr-text); }
  .hr-header { background: var(--hr-navy); color: #fff; box-shadow: 0 2px 12px rgba(15, 23, 42, .12); position: relative; z-index: 1030; }
  .hr-header .hr-inner { max-width: 1600px; margin: auto; min-height: 68px; padding: 0 24px; display: flex; align-items: center; gap: 24px; }
  .hr-brand { display: inline-flex; align-items: center; gap: 11px; color: #fff; text-decoration: none; flex: 0 0 auto; }
  .hr-brand:hover, .hr-brand:focus { color: #fff; }
  .hr-brand-icon { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 9px; background: #315783; color: #fff; }
  .hr-brand-title { font-size: 1rem; font-weight: 750; line-height: 1.25; white-space: nowrap; }
  .hr-brand-subtitle { display: block; color: #aebed2; font-size: .7rem; font-weight: 400; letter-spacing: .02em; }
  .hr-nav { min-width: 0; flex: 1 1 auto; }
  .hr-nav .navbar-nav { align-items: center; gap: 2px; }
  .hr-nav .nav-link { display: flex; align-items: center; gap: 7px; padding: 10px 11px; border-radius: 7px; color: #c8d5e5; font-size: .875rem; font-weight: 550; white-space: nowrap; }
  .hr-nav .nav-link:hover, .hr-nav .nav-link:focus, .hr-nav .nav-link.active, .hr-nav .nav-link.show { background: var(--hr-navy-light); color: #fff; }
  .hr-nav .nav-link i { width: 16px; text-align: center; }
  .hr-nav .dropdown-menu { border: 1px solid var(--hr-border); border-radius: 10px; padding: 6px; min-width: 210px; box-shadow: 0 12px 28px rgba(15, 23, 42, .16); }
  .hr-nav .dropdown-item { border-radius: 6px; padding: 9px 11px; color: var(--hr-text); font-size: .875rem; }
  .hr-nav .dropdown-item i { width: 20px; color: #64748b; }
  .hr-nav .dropdown-item:hover, .hr-nav .dropdown-item:focus, .hr-nav .dropdown-item.active { background: #eff5ff; color: #1d4ed8; }
  .hr-actions { display: flex; align-items: center; gap: 12px; flex: 0 0 auto; }
  .hr-user { display: flex; flex-direction: column; line-height: 1.3; max-width: 150px; }
  .hr-user strong { font-size: .82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hr-user small { font-size: .72rem; color: #aebed2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .hr-actions .btn { font-size: .8rem; font-weight: 600; white-space: nowrap; border-radius: 7px; }
  .hr-logout { color: #e1e9f3; border-color: #5b708b; }
  .hr-logout:hover { background: #fff; border-color: #fff; color: var(--hr-navy); }
  .hr-toggle { display: none; color: #fff; border: 1px solid #5b708b; border-radius: 7px; padding: 7px 10px; background: transparent; }
  .hr-toggle:hover, .hr-toggle:focus-visible { background: var(--hr-navy-light); }
  .hr-header .dropdown-toggle::after { margin-left: 4px; }
  @media (max-width: 1350px) {
    .hr-header .hr-inner { flex-wrap: wrap; gap: 0 16px; padding-top: 10px; }
    .hr-nav { order: 3; flex-basis: 100%; }
    .hr-actions { margin-left: auto; }
    .hr-nav .navbar-nav { min-height: 48px; }
  }
  @media (max-width: 991.98px) {
    .hr-header .hr-inner { min-height: 62px; padding: 10px 16px; }
    .hr-toggle { display: inline-flex; align-items: center; justify-content: center; }
    .hr-nav { order: 3; flex-basis: 100%; }
    .hr-nav .navbar-nav { align-items: stretch; padding: 12px 0 4px; border-top: 1px solid #344b69; margin-top: 10px; }
    .hr-nav .nav-link { padding: 11px 12px; }
    .hr-nav .dropdown-menu { position: static !important; transform: none !important; box-shadow: none; border: 0; border-radius: 7px; background: #1c314d; margin: 3px 0 7px 15px; }
    .hr-nav .dropdown-item { color: #d4e0ee; }
    .hr-nav .dropdown-item i { color: #9cb2cf; }
    .hr-nav .dropdown-item:hover, .hr-nav .dropdown-item:focus, .hr-nav .dropdown-item.active { background: #315783; color: #fff; }
    .hr-nav .dropdown-divider { border-color: #48607b; }
    .hr-user, .hr-notice { display: none; }
  }
  @media (max-width: 575.98px) {
    .hr-header .hr-inner { gap: 8px; }
    .hr-brand-title { font-size: .88rem; }
    .hr-brand-subtitle { display: none; }
    .hr-brand-icon { width: 31px; height: 31px; }
    .hr-actions { gap: 7px; }
    .hr-logout { padding: 6px 8px; }
    .hr-logout span { display: none; }
  }
</style>
<header class="hr-header">
  <div class="hr-inner">
    <a class="hr-brand" href="<%= hrLoggedIn ? '/dashboard' : '/auth/login' %>">
      <span class="hr-brand-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
      <span class="hr-brand-title">보안근무 관리 시스템<small class="hr-brand-subtitle">Security Work Management</small></span>
    </a>
    <% if (hrLoggedIn) { %>
    <nav class="hr-nav navbar navbar-expand-lg p-0" aria-label="주 메뉴">
      <div class="collapse navbar-collapse" id="hrNavigation">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="fa-solid fa-chart-line" aria-hidden="true"></i>대시보드</a></li>
          <li class="nav-item"><a class="nav-link" href="/employees"><i class="fa-solid fa-users" aria-hidden="true"></i>직원 찾기</a></li>
          <li class="nav-item"><a class="nav-link" href="/boards"><i class="fa-solid fa-comments" aria-hidden="true"></i>게시판</a></li>
          <% if (hrAdmin) { %>
          <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-gear" aria-hidden="true"></i>관리자</button>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/boards/admin/reports"><i class="fa-solid fa-flag" aria-hidden="true"></i>게시판 신고 관리</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/uniform/stats"><i class="fa-solid fa-shirt" aria-hidden="true"></i>유니폼 현황</a></li>
              <li><a class="dropdown-item" href="/auth/logs"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>활동 로그 관리</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-file-excel" aria-hidden="true"></i>엑셀관리</button>
            <ul class="dropdown-menu"><li><a class="dropdown-item" href="/excelManager"><i class="fa-solid fa-table" aria-hidden="true"></i>통합 엑셀 관리</a></li></ul>
          </li>
          <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>정보 입력</button>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/employees/new"><i class="fa-solid fa-user-plus" aria-hidden="true"></i>신입사원등록</a></li>
              <li><a class="dropdown-item" href="/employees/existing"><i class="fa-solid fa-user-pen" aria-hidden="true"></i>등록사원수정</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/attendance"><i class="fa-solid fa-clock" aria-hidden="true"></i>근태 입력</a></li>
              <li><a class="dropdown-item" href="/monthlyAttendance"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i>월간 근태현황</a></li>
              <li><a class="dropdown-item" href="/workSchedule"><i class="fa-solid fa-calendar-check" aria-hidden="true"></i>근무 스케줄 관리</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-shield" aria-hidden="true"></i>보안업무</button>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/duty-orders"><i class="fa-solid fa-clipboard-list" aria-hidden="true"></i>인사명령서</a></li>
              <li><a class="dropdown-item" href="/work-orders"><i class="fa-solid fa-file-lines" aria-hidden="true"></i>근무명령서</a></li>
              <li><a class="dropdown-item" href="/security/summary-reports"><i class="fa-solid fa-chart-bar" aria-hidden="true"></i>요약보고서</a></li>
              <li><a class="dropdown-item" href="/handovers"><i class="fa-solid fa-right-left" aria-hidden="true"></i>인계장</a></li>
              <li><a class="dropdown-item" href="/security/schedule"><i class="fa-solid fa-calendar" aria-hidden="true"></i>일정</a></li>
            </ul>
          </li>
          <% } %>
        </ul>
      </div>
    </nav>
    <div class="hr-actions">
      <% if (hrAdmin) { %><a class="btn btn-primary btn-sm hr-notice" href="/notice/new"><i class="fa-solid fa-bullhorn me-1" aria-hidden="true"></i>시스템 공지</a><% } %>
      <div class="hr-user"><strong><%= hrName %></strong><small><%= hrPosition || (hrAdmin ? '관리자' : '사용자') %></small></div>
      <a class="btn btn-sm hr-logout" href="/auth/logout" aria-label="로그아웃"><i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i><span class="ms-1">로그아웃</span></a>
      <button class="hr-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#hrNavigation" aria-controls="hrNavigation" aria-expanded="false" aria-label="메뉴 열기"><i class="fa-solid fa-bars" aria-hidden="true"></i></button>
    </div>
    <% } else { %>
    <div class="hr-actions ms-auto"><a class="btn btn-primary btn-sm" href="/auth/login">로그인</a><a class="btn btn-sm hr-logout" href="/auth/register">회원가입</a></div>
    <% } %>
  </div>
</header>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const pathname = window.location.pathname.replace(/\/$/, '') || '/';
    const links = Array.from(document.querySelectorAll('.hr-nav a[href]'));
    const exact = links.find(link => link.getAttribute('href') === pathname);
    const match = exact || links.filter(link => {
      const href = link.getAttribute('href');
      return href !== '/dashboard' && pathname.startsWith(href + '/');
    }).sort((a, b) => b.getAttribute('href').length - a.getAttribute('href').length)[0];
    if (match) {
      match.classList.add('active');
      match.setAttribute('aria-current', 'page');
      const dropdown = match.closest('.dropdown');
      if (dropdown) dropdown.querySelector('.dropdown-toggle').classList.add('active');
    }
    const menu = document.getElementById('hrNavigation');
    if (menu) menu.querySelectorAll('a[href]').forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth < 992 && window.bootstrap) {
          window.bootstrap.Collapse.getOrCreateInstance(menu, { toggle: false }).hide();
        }
      });
    });
  });
  function hrToast(message, tone, delay) {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'toast-container position-fixed top-0 end-0 p-3';
      container.style.zIndex = '1090';
      document.body.appendChild(container);
    }
    const toast = document.createElement('div');
    toast.className = 'toast show text-white bg-' + tone;
    const body = document.createElement('div');
    body.className = 'toast-body';
    body.textContent = String(message);
    toast.appendChild(body);
    container.appendChild(toast);
    if (delay) window.setTimeout(() => toast.remove(), delay);
    return toast;
  }
  function showLoadingToast(message) { return hrToast(message, 'info', 0); }
  function hideLoadingToast(toast) { if (toast) toast.remove(); }
  function showSuccessToast(message) { return hrToast(message, 'success', 3000); }
  function showErrorToast(message) { return hrToast(message, 'danger', 5000); }
  function createToastContainer() {
    let container = document.getElementById('toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'toast-container position-fixed top-0 end-0 p-3';
      container.style.zIndex = '1090';
      document.body.appendChild(container);
    }
    return container;
  }
</script>
