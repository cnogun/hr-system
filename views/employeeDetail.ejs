<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>직원 상세보기</title>
<style>
.hr-detail-page{width:min(100% - 32px,1240px);margin:16px auto 44px;color:#14243c;font-size:13px;line-height:1.4}.hr-title-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:8px}.hr-title-row h1{font-size:21px;font-weight:750;margin:0}.hr-title-actions,.hr-actions{display:flex;gap:8px;flex-wrap:wrap}.hr-card{background:#fff;border:1px solid #e2e8f0;border-radius:10px;margin:10px 0;overflow:hidden;box-shadow:0 2px 8px #0f172a09}.hr-card h2{font-size:15px;font-weight:700;margin:0;padding:12px 15px 0}.hr-basic-layout{display:grid;grid-template-columns:210px minmax(0,1fr);gap:14px;padding:11px 15px 14px}.hr-photo{padding-right:13px;border-right:1px solid #e2e8f0;text-align:center}.hr-photo-preview{width:118px;height:148px;margin:0 auto 8px;border:1px solid #dbe3f0;border-radius:8px;background:#eef2ff;display:grid;place-items:center;overflow:hidden;color:#64748b;font-size:12px}.hr-photo-preview img{width:100%;height:100%;object-fit:cover}.hr-photo-empno{margin:7px 0;padding:6px 8px;border-radius:7px;background:#eef2ff;color:#475569;font-size:11px}.hr-photo-empno strong{display:block;margin-top:2px;color:#14243c;font-size:12px}.hr-grid{padding:11px 15px 14px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px 10px}.hr-basic-layout>.hr-grid{padding:0}.hr-basic-fields{grid-template-columns:repeat(6,minmax(0,1fr))}.hr-military-grid{grid-template-columns:repeat(5,minmax(0,1fr))}.hr-career-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.hr-field label{display:block;font-weight:650;font-size:12px;margin-bottom:4px}.hr-value{width:100%;min-height:34px;padding:7px 8px;border:1px solid #dbe3f0;border-radius:7px;background:#f8fafc;color:#14243c;font-size:12px;line-height:1.45;overflow-wrap:anywhere}.hr-value.multiline{min-height:72px;white-space:pre-wrap}.hr-wide{grid-column:span 2}details.hr-card summary{display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;font-weight:700;padding:11px 15px;list-style:none}details.hr-card summary::-webkit-details-marker{display:none}details.hr-card summary::after{content:'열기';font-size:11px;font-weight:600;color:#2563eb}details.hr-card[open] summary{border-bottom:1px solid #e2e8f0}details.hr-card[open] summary::after{content:'닫기'}.hr-actions{justify-content:flex-end;margin:14px 0}.hr-actions .btn,.hr-title-actions .btn{padding:7px 16px}@media(max-width:1100px){.hr-basic-fields{grid-template-columns:repeat(3,minmax(0,1fr))}.hr-military-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:650px){.hr-title-row{align-items:flex-start;flex-direction:column}.hr-basic-layout{grid-template-columns:1fr;padding:12px}.hr-photo{padding:0 0 12px;border-right:0;border-bottom:1px solid #e2e8f0}.hr-photo-preview{width:84px;height:106px}.hr-grid,.hr-basic-fields,.hr-military-grid,.hr-career-grid{grid-template-columns:1fr;padding:12px}.hr-basic-layout>.hr-grid{padding:0}.hr-wide{grid-column:auto}.hr-title-actions{width:100%}.hr-title-actions .btn{flex:1;text-align:center}}
</style></head><body><%- include('header') %>
<% const v=(key)=>employee&&employee[key]!=null&&String(employee[key]).trim()!==''?String(employee[key]):'-'; const d=(key)=>employee&&employee[key]?(employee[key] instanceof Date?employee[key].toISOString().slice(0,10):String(employee[key]).slice(0,10)):'-'; %>
<main class="hr-detail-page"><div class="hr-title-row"><h1>직원 상세정보</h1><div class="hr-title-actions"><a class="btn btn-outline-secondary" href="/employees">직원 찾기</a><% if(typeof session!=='undefined'&&session&&session.userRole==='admin'){ %><a class="btn btn-primary" href="/employees/<%= employee._id %>/edit">직원 정보 수정</a><% } %></div></div>
<section class="hr-card"><h2>기본 정보</h2><div class="hr-basic-layout"><div class="hr-photo"><div class="hr-photo-preview"><% if(employee.profileImage){ %><img src="<%= employee.profileImage %>" alt="<%= employee.name %> 프로필 사진"><% }else{ %><span>사진 없음</span><% } %></div><div class="hr-photo-empno">사번<strong><%= v('empNo') %></strong></div></div><div class="hr-grid hr-basic-fields">
<div class="hr-field"><label>이름</label><div class="hr-value"><%= v('name') %></div></div><div class="hr-field"><label>입사일</label><div class="hr-value"><%= d('hireDate') %></div></div><div class="hr-field"><label>소속</label><div class="hr-value"><%= v('orgType') %></div></div><div class="hr-field"><label>부서</label><div class="hr-value"><%= v('department') %></div></div><div class="hr-field"><label>직급</label><div class="hr-value"><%= v('position') %></div></div><div class="hr-field"><label>고용형태</label><div class="hr-value"><%= v('employmentType') %></div></div>
<div class="hr-field"><label>생년월일</label><div class="hr-value"><%= d('birth') %></div></div><div class="hr-field"><label>휴대폰</label><div class="hr-value"><%= v('mobile') %></div></div><div class="hr-field"><label>이메일</label><div class="hr-value"><%= v('email') %></div></div><div class="hr-field"><label>성별</label><div class="hr-value"><%= v('gender') %></div></div><div class="hr-field"><label>국적</label><div class="hr-value"><%= v('nationality') %></div></div><div class="hr-field"><label>학력</label><div class="hr-value"><%= v('education') %></div></div>
<div class="hr-field hr-wide"><label>주소</label><div class="hr-value"><%= v('address') %></div></div><div class="hr-field"><label>신장(cm)</label><div class="hr-value"><%= v('height') %></div></div><div class="hr-field"><label>체중(kg)</label><div class="hr-value"><%= v('weight') %></div></div><div class="hr-field"><label>혈액형</label><div class="hr-value"><%= v('bloodType') %></div></div><div class="hr-field"><label>재직 상태</label><div class="hr-value"><%= v('status') %></div></div>
</div></div></section>
<details class="hr-card"><summary>병역 사항</summary><div class="hr-grid hr-military-grid"><div class="hr-field"><label>군별</label><div class="hr-value"><%= v('militaryBranch') %></div></div><div class="hr-field"><label>계급</label><div class="hr-value"><%= v('militaryRank') %></div></div><div class="hr-field"><label>군번</label><div class="hr-value"><%= v('militaryNumber') %></div></div><div class="hr-field"><label>복무기간</label><div class="hr-value"><%= v('militaryServicePeriod') %></div></div><div class="hr-field"><label>미필·면제 사유</label><div class="hr-value"><%= v('militaryExemptionReason') %></div></div></div></details>
<details class="hr-card"><summary>경력/자격/특이사항</summary><div class="hr-grid hr-career-grid"><div class="hr-field"><label>경력사항</label><div class="hr-value multiline"><%= v('career') %></div></div><div class="hr-field"><label>자격사항</label><div class="hr-value multiline"><%= v('qualifications') %></div></div><div class="hr-field"><label>특이사항</label><div class="hr-value multiline"><%= v('specialNotes') %></div></div></div></details>
<% if(typeof session!=='undefined'&&session&&session.userRole==='admin'){ %><details class="hr-card"><summary>급여 정보</summary><div class="hr-grid"><div class="hr-field"><label>급여 은행</label><div class="hr-value"><%= v('salaryBank') %></div></div><div class="hr-field"><label>급여 계좌</label><div class="hr-value"><%= v('salaryAccount') %></div></div></div></details><% } %>
<div class="hr-actions"><a class="btn btn-outline-secondary" href="/employees">목록으로</a></div></main><%- include('footer') %></body></html>
