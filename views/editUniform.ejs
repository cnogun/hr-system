<%- include('header') %>
<style>
.ue-page{max-width:1150px;margin:24px auto 64px;padding:0 22px;color:#172b4d;font-size:.88rem}.ue-head{margin-bottom:16px}.ue-head h1{font-size:1.35rem;margin:0}.ue-card{background:#fff;border:1px solid #dbe4ef;border-radius:12px;box-shadow:0 4px 14px rgba(30,54,87,.06);padding:16px}.ue-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.ue-row{display:grid;grid-template-columns:1fr 78px;gap:7px;background:#f6f9fc;border-radius:9px;padding:10px}.ue-row label{grid-column:1/-1;font-size:.78rem;font-weight:700;color:#48617e}.ue-row select,.ue-row input{width:100%;border:1px solid #c8d5e5;border-radius:7px;padding:8px;background:#fff;font-size:.82rem}.ue-actions{display:flex;justify-content:center;gap:8px;margin-top:16px}.ue-btn{border:0;border-radius:7px;padding:8px 15px;background:#1769aa;color:#fff;text-decoration:none;font-size:.82rem;font-weight:700}.ue-btn.light{background:#edf2f7;color:#244368}@media(max-width:850px){.ue-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.ue-grid{grid-template-columns:1fr}}
</style>
<main class="ue-page">
 <div class="ue-head"><h1>유니폼 정보 수정</h1><div><%= employee.name %> · <%= employee.department||'-' %></div></div>
 <form method="post" action="<%= session&&session.userRole==='admin'?'/uniform/'+employee._id+'/edit':'/uniform/edit' %>">
  <section class="ue-card"><div class="ue-grid">
   <% items.forEach(i=>{ %><div class="ue-row"><label><%= i.name %></label><select name="<%= i.key %>"><option value="">선택 안 함</option><% i.sizes.forEach(size=>{ %><option value="<%= size %>" <%= employee[i.key]===size?'selected':'' %>><%= size %></option><% }) %></select><input type="number" name="<%= i.qty %>" min="0" max="99" value="<%= Number(employee[i.qty])||0 %>" aria-label="<%= i.name %> 수량"></div><% }) %>
  </div></section>
  <div class="ue-actions"><a class="ue-btn light" href="<%= session&&session.userRole==='admin'?'/uniform/'+employee._id:'/uniform' %>">취소</a><button class="ue-btn">저장</button></div>
 </form>
</main>
<%- include('footer') %>
