<%- include('header') %>
<style>
.ud-page{max-width:1280px;margin:24px auto 64px;padding:0 22px;color:#172b4d;font-size:.88rem}.ud-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:15px}.ud-head h1{font-size:1.35rem;margin:0}.ud-actions{display:flex;gap:8px}.ud-btn{border:0;border-radius:7px;padding:8px 12px;background:#1769aa;color:#fff;text-decoration:none;font-size:.82rem;font-weight:700}.ud-btn.light{background:#edf2f7;color:#244368}.ud-card{background:#fff;border:1px solid #dbe4ef;border-radius:12px;box-shadow:0 4px 14px rgba(30,54,87,.06);padding:16px;margin-bottom:15px}.ud-card h2{font-size:1.05rem}.ud-profile{display:flex;gap:14px;align-items:center}.ud-photo{width:64px;height:78px;border-radius:9px;object-fit:cover;background:#e9eff6}.ud-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.ud-item{background:#f6f9fc;border-radius:9px;padding:10px}.ud-item span{display:block;color:#71839a;font-size:.76rem}.ud-item strong{display:block;margin-top:3px;font-size:.88rem}.ud-table{width:100%;border-collapse:collapse;font-size:.84rem}.ud-table th,.ud-table td{padding:8px 9px;border-bottom:1px solid #e4ebf3;text-align:left}.ud-table th{background:#f5f8fc;color:#48617e;font-size:.78rem}.ud-form{display:grid;grid-template-columns:2fr 1fr 1fr 1fr 2fr auto;gap:7px}.ud-form input,.ud-form select{min-width:0;padding:8px;border:1px solid #c8d5e5;border-radius:7px;font-size:.82rem}.ud-alert{padding:10px;background:#eaf8ef;color:#176338;border-radius:8px;margin-bottom:14px}@media(max-width:900px){.ud-grid{grid-template-columns:repeat(2,1fr)}.ud-form{grid-template-columns:1fr 1fr}.ud-head{align-items:flex-start;flex-direction:column}}@media(max-width:560px){.ud-grid,.ud-form{grid-template-columns:1fr}}
</style>
<main class="ud-page">
 <% if(message){ %><div class="ud-alert"><%= message %></div><% } %>
 <div class="ud-head"><div><h1>유니폼 상세</h1><div><%= employee.name %> · <%= employee.empNo||'사번 없음' %></div></div><div class="ud-actions"><% if(session&&session.userRole==='admin'){ %><a class="ud-btn light" href="/uniform">목록</a><a class="ud-btn" href="/uniform/<%= employee._id %>/edit">사이즈 수정</a><% }else{ %><a class="ud-btn" href="/uniform/edit">수정</a><% } %></div></div>
 <section class="ud-card ud-profile"><% if(employee.profileImage){ %><img class="ud-photo" src="<%= employee.profileImage %>" alt=""><% }else{ %><div class="ud-photo"></div><% } %><div><strong><%= employee.name %></strong><div><%= employee.department||'-' %> / <%= employee.position||'-' %></div></div></section>
 <section class="ud-card"><h2>사이즈 및 신청 수량</h2><div class="ud-grid"><% items.forEach(i=>{ %><div class="ud-item"><span><%= i.name %></span><strong><%= employee[i.key]||'-' %> · <%= employee[i.key]?(Number(employee[i.qty])||0):0 %>개</strong></div><% }) %></div></section>
 <% if(session&&session.userRole==='admin'){ %><section class="ud-card"><h2>지급 이력 등록</h2><form class="ud-form" action="/uniform/<%= employee._id %>/issues" method="post"><select id="issueItemKey" name="itemKey" required><option value="">품목 선택</option><% items.forEach(i=>{ %><option value="<%= i.key %>" data-sizes='<%= JSON.stringify(i.sizes) %>' data-current="<%= employee[i.key]||'' %>"><%= i.name %></option><% }) %></select><select id="issueSize" name="size" required disabled><option value="">품목을 먼저 선택하세요</option></select><input name="quantity" type="number" min="1" value="1" required><input name="issuedAt" type="date" value="<%= new Date().toISOString().slice(0,10) %>" required><input name="note" maxlength="300" placeholder="비고"><button class="ud-btn">지급 등록</button></form></section><% } %>
 <section class="ud-card"><h2>지급 이력</h2><div style="overflow:auto"><table class="ud-table"><thead><tr><th>지급일</th><th>품목</th><th>사이즈</th><th>수량</th><th>비고</th><% if(session&&session.userRole==='admin'){ %><th></th><% } %></tr></thead><tbody>
 <% const issues=(employee.uniformIssues||[]).slice().sort((a,b)=>new Date(b.issuedAt)-new Date(a.issuedAt)); issues.forEach(h=>{ %><tr><td><%= new Date(h.issuedAt).toLocaleDateString('ko-KR') %></td><td><%= h.itemName %></td><td><%= h.size||'-' %></td><td><%= h.quantity %></td><td><%= h.note||'-' %></td><% if(session&&session.userRole==='admin'){ %><td><form action="/uniform/<%= employee._id %>/issues/<%= h._id %>/delete" method="post" onsubmit="return confirm('이 지급 이력을 삭제할까요?')"><button class="ud-btn light">삭제</button></form></td><% } %></tr><% }) %>
 </tbody></table><% if(!issues.length){ %><p style="text-align:center;color:#71839a;padding:25px">등록된 지급 이력이 없습니다.</p><% } %></div></section>
</main>
<%- include('footer') %>
<script>
document.addEventListener('DOMContentLoaded',function(){
  const itemSelect=document.getElementById('issueItemKey');
  const sizeSelect=document.getElementById('issueSize');
  if(!itemSelect||!sizeSelect)return;
  itemSelect.addEventListener('change',function(){
    const option=itemSelect.options[itemSelect.selectedIndex];
    let sizes=[];
    try{sizes=JSON.parse(option.dataset.sizes||'[]');}catch(error){sizes=[];}
    const current=option.dataset.current||'';
    sizeSelect.innerHTML='<option value="">사이즈 선택</option>';
    sizes.forEach(function(size){
      const sizeOption=document.createElement('option');
      sizeOption.value=size;
      sizeOption.textContent=size;
      if(size===current)sizeOption.selected=true;
      sizeSelect.appendChild(sizeOption);
    });
    sizeSelect.disabled=sizes.length===0;
  });
});
</script>
