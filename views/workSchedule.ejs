  <!-- Bootstrap JS는 header.ejs에서 로드됨 -->
  
  <script>

    
         // 기본 JavaScript 초기화
     document.addEventListener('DOMContentLoaded', function() {
       console.log('근무 스케줄 관리 페이지 로드 완료');
       mergeScheduleSummaryLayout();
       showScheduleMenu('main');
       
       updateTeamWorkSchedule(); // 팀 근무 형태 자동 업데이트
       loadCurrentWeekInfo();
       refreshWeekendSummaryFromBasicRoster(); // 기본 편성값으로 주말 요약 계산
       const initialDate = new Date();
       const daysToSaturday = (6 - initialDate.getDay() + 7) % 7;
       initialDate.setDate(initialDate.getDate() + daysToSaturday);
       document.getElementById('manualDate').value = initialDate.toISOString().slice(0, 10);
       updateManualDateDay();
       loadDutyRoster();
       loadAssignmentEmployees();
       loadConfirmedAssignments();
       
       console.log('WorkSchedule 페이지 로드 완료');
     });

    function mergeScheduleSummaryLayout() {
      const overview = document.getElementById('weeklyOverviewCard');
      const summary = document.getElementById('weekendSummaryCard');
      if (!overview || !summary || document.getElementById('inlineWeekendSummary')) return;
      const summaryRow = summary.querySelector('.card-body > .row');
      const overviewBody = overview.querySelector('.card-body');
      if (!summaryRow || !overviewBody) return;
      const inline = document.createElement('div');
      inline.id = 'inlineWeekendSummary';
      inline.innerHTML = '<hr class="my-3"><div class="d-flex align-items-center mb-2"><i class="fa-solid fa-calculator text-success me-2"></i><strong>주말 근무 인원 요약</strong></div>';
      inline.appendChild(summaryRow);
      overviewBody.appendChild(inline);
      summary.classList.add('d-none');
    }

    function showScheduleMenu(section) {
      const container = document.querySelector('.work-schedule-container');
      if (container) {
        container.classList.remove('view-main', 'view-roster', 'view-holiday');
        container.classList.add(`view-${section}`);
      }
      const visibility = {
        weeklyOverviewCard: section === 'main',
        manualAssignmentCard: section === 'main',
        confirmedAssignmentsListCard: section === 'main',
        basicRosterSection: section === 'roster',
        holidayManagementSection: section === 'holiday'
      };
      Object.entries(visibility).forEach(([id, visible]) => {
        document.getElementById(id)?.classList.toggle('d-none', !visible);
      });
      document.getElementById('weekendSummaryCard')?.classList.add('d-none');
      ['Main', 'Roster', 'Holiday'].forEach(name => {
        const button = document.getElementById(`menu${name}`);
        if (button) button.classList.toggle('active', name.toLowerCase() === section);
      });
      if (section === 'roster') loadDutyRoster();
      if (section === 'holiday') loadHolidayList();
    }
     

     

    
    let assignmentEmployees = [];
    let confirmedAssignmentsLoading = false;

    function rosterSelect(className, employeeId, values, selectedValue) {
      const changeHandler = className === 'roster-role' ? ' onchange="syncLeaderGroupState(this.closest(\'tr\')); filterDutyRosterRows()"' : '';
      return `<select class="form-select form-select-sm ${className}" data-employee-id="${employeeId}"${changeHandler}>` +
        values.map(item => `<option value="${item.value}" ${item.value === selectedValue ? 'selected' : ''}>${item.label}</option>`).join('') +
        `</select>`;
    }

    async function loadDutyRoster() {
      const body = document.getElementById('dutyRosterBody');
      body.innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">직원 목록을 불러오는 중입니다.</td></tr>';
      try {
        const team = document.getElementById('rosterTeam').value;
        const response = await fetch(`/workSchedule/assignment-employees?team=${team}`);
        const result = await response.json();
        if (!result.success) throw new Error(result.message);
        const roleOptions = [
          { value: '', label: '미분류' }, { value: 'leader', label: '조장' },
          { value: 'general', label: '일반경비' }, { value: 'special', label: '특수경비' }
        ];
        const abOptions = [{ value: 'none', label: '-' }, { value: 'A조', label: 'A조' }, { value: 'B조', label: 'B조' }];
        const sundayOptions = [{ value: 'none', label: '-' }, 1, 2, 3, 4].flatMap(item =>
          typeof item === 'number' ? [{ value: `${item}조`, label: `${item}조` }] : [item]
        );
        const specialOptions = [{ value: '', label: '-' }, 1, 2, 3, 4, 5].flatMap(item =>
          typeof item === 'number' ? [{ value: String(item), label: `특수 ${item}조` }] : [item]
        );
        body.innerHTML = result.data.map(employee => {
          const duty = employee.securityDuty || {};
          const assignment = employee.weekendAssignment || {};
          return `<tr data-employee-id="${employee._id}">
            <td>${employee.empNo || '-'}</td><td class="fw-semibold">${employee.name}</td>
            <td>${rosterSelect('roster-role', employee._id, roleOptions, duty.category || '')}</td>
            <td class="roster-group-cell">
              ${rosterSelect('roster-sunday', employee._id, sundayOptions, assignment.sundayGroup || 'none')}
              ${rosterSelect('roster-special', employee._id, specialOptions, duty.specialGroup ? String(duty.specialGroup) : '')}
              <span class="roster-group-empty text-muted">-</span>
            </td>
            <td>${rosterSelect('roster-ab', employee._id, abOptions, assignment.weekendGroup || 'none')}</td>
          </tr>`;
        }).join('') || '<tr><td colspan="5" class="text-center text-muted py-4">재직 직원이 없습니다.</td></tr>';
        Array.from(body.querySelectorAll('tr[data-employee-id]')).forEach(syncLeaderGroupState);
        filterDutyRosterRows();
      } catch (error) {
        body.innerHTML = `<tr><td colspan="5" class="text-center text-danger py-4">${error.message}</td></tr>`;
      }
    }

    function syncLeaderGroupState(row) {
      if (!row) return;
      const category = row.querySelector('.roster-role')?.value || '';
      const generalGroupSelect = row.querySelector('.roster-sunday');
      const specialGroupSelect = row.querySelector('.roster-special');
      const emptyLabel = row.querySelector('.roster-group-empty');
      if (!generalGroupSelect || !specialGroupSelect || !emptyLabel) return;

      if (category === 'leader') generalGroupSelect.value = 'none';
      generalGroupSelect.disabled = category === 'leader';
      generalGroupSelect.classList.toggle('d-none', category !== 'general');
      specialGroupSelect.classList.toggle('d-none', category !== 'special');
      emptyLabel.classList.toggle('d-none', category === 'general' || category === 'special');
      generalGroupSelect.title = category === 'leader'
        ? '일요일 지원조장은 조장2·3·4가 자동 순환하며, 해당 조장만 전날 토요일 명단에서 제외됩니다.'
        : '';
    }

    function filterDutyRosterRows() {
      const query = (document.getElementById('rosterSearch')?.value || '').trim().toLowerCase();
      const role = document.getElementById('rosterRoleFilter')?.value ?? 'all';
      const rows = Array.from(document.querySelectorAll('#dutyRosterBody tr[data-employee-id]'));
      let visible = 0;
      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        const rowRole = row.querySelector('.roster-role')?.value || '';
        const show = (!query || text.includes(query)) && (role === 'all' || rowRole === role);
        row.classList.toggle('d-none', !show);
        if (show) visible += 1;
      });
      const count = document.getElementById('rosterVisibleCount');
      if (count) count.textContent = `${visible}/${rows.length}명 표시`;
    }

    function applyDefaultRoleTemplate() {
      const rows = Array.from(document.querySelectorAll('#dutyRosterBody tr[data-employee-id]'));
      if (rows.length < 38) {
        showResult(`기본 역할 배정에는 팀원이 최소 38명 필요합니다. 현재 ${rows.length}명입니다.`, 'warning');
        return;
      }
      rows.forEach((row, index) => {
        const roleSelect = row.querySelector('.roster-role');
        const abSelect = row.querySelector('.roster-ab');
        const sundaySelect = row.querySelector('.roster-sunday');
        const specialSelect = row.querySelector('.roster-special');
        if (index < 4) {
          roleSelect.value = 'leader';
          abSelect.value = index < 2 ? 'A조' : 'B조';
          sundaySelect.value = 'none';
          specialSelect.value = '';
        } else if (index < 28) {
          const generalIndex = index - 4;
          roleSelect.value = 'general';
          abSelect.value = generalIndex < 12 ? 'A조' : 'B조';
          sundaySelect.value = `${Math.floor(generalIndex / 6) + 1}조`;
          specialSelect.value = '';
        } else if (index < 38) {
          const specialIndex = index - 28;
          roleSelect.value = 'special';
          abSelect.value = specialIndex < 5 ? 'A조' : 'B조';
          // 특수경비는 일반 1~4조가 아닌 특수 1~5조만 사용한다.
          sundaySelect.value = 'none';
          specialSelect.value = String(Math.floor(specialIndex / 2) + 1);
        } else {
          roleSelect.value = '';
          abSelect.value = 'none';
          sundaySelect.value = 'none';
          specialSelect.value = '';
        }
        syncLeaderGroupState(row);
      });
      filterDutyRosterRows();
      const excluded = Math.max(0, rows.length - 38);
      showResult(`사번 순으로 조장 4명, 일반경비 24명, 특수경비 10명을 편성했습니다.${excluded ? ` 초과 ${excluded}명은 미편성으로 남겼습니다.` : ''} 확인 후 기본 편성 저장을 눌러주세요.`, 'info');
    }

    async function saveDutyRoster() {
      const rows = Array.from(document.querySelectorAll('#dutyRosterBody tr[data-employee-id]'));
      const entries = rows.map(row => {
        const category = row.querySelector('.roster-role').value;
        return {
          employeeId: row.dataset.employeeId,
          category,
          weekendGroup: row.querySelector('.roster-ab').value,
          sundayGroup: category === 'general' ? row.querySelector('.roster-sunday').value : 'none',
          specialGroup: row.querySelector('.roster-special').value || null
        };
      });
      try {
        const response = await fetch('/workSchedule/employee-duty-bulk', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ entries })
        });
        const result = await response.json();
        if (!result.success) throw new Error(result.message);

        // 저장 직후 서버에서 다시 조회해 실제 반영 여부를 확인한다.
        const team = document.getElementById('rosterTeam').value;
        const verifyResponse = await fetch(`/workSchedule/assignment-employees?team=${team}`);
        const verifyResult = await verifyResponse.json();
        if (!verifyResult.success) throw new Error('저장 후 편성 정보를 다시 확인하지 못했습니다.');
        const savedById = new Map(verifyResult.data.map(employee => [String(employee._id), employee]));
        const mismatch = entries.find(entry => {
          const employee = savedById.get(String(entry.employeeId));
          if (!employee) return true;
          const duty = employee.securityDuty || {};
          const assignment = employee.weekendAssignment || {};
          return (duty.category || '') !== entry.category ||
            (assignment.weekendGroup || 'none') !== entry.weekendGroup ||
            (assignment.sundayGroup || 'none') !== entry.sundayGroup ||
            String(duty.specialGroup || '') !== String(entry.specialGroup || '');
        });
        if (mismatch) throw new Error('일부 직원의 기본 편성이 저장값과 일치하지 않습니다. 다시 확인해주세요.');

        showResult(`${result.message} 저장값 재조회까지 확인했습니다.`, 'success');
        document.getElementById('manualTeam').value = document.getElementById('rosterTeam').value;
        await Promise.all([loadDutyRoster(), loadAssignmentEmployees(), refreshWeekendSummaryFromBasicRoster()]);
      } catch (error) {
        showResult(error.message || '기본 편성을 저장하지 못했습니다.', 'danger');
      }
    }

    async function refreshWeekendSummaryFromBasicRoster() {
      try {
        const responses = await Promise.all([1, 2, 3].map(team =>
          fetch(`/workSchedule/assignment-employees?team=${team}`).then(response => response.json())
        ));
        if (responses.some(result => !result.success)) {
          throw new Error('기본 편성 명단을 불러오지 못했습니다.');
        }

        responses.forEach((result, index) => {
          const team = index + 1;
          const employees = result.data || [];
          const employeeLines = list => list.map(employee =>
            `${employee.name}${employee.empNo ? ` (${employee.empNo})` : ''}`
          ).join('\n');
          const byWeekendGroup = group => employees.filter(employee =>
            (employee.weekendAssignment || {}).weekendGroup === group
          );
          const bySundayGroup = group => employees.filter(employee => {
            const category = (employee.securityDuty || {}).category;
            if (category === 'special') {
              return Number((employee.securityDuty || {}).specialGroup) === Number(group.replace('조', ''));
            }
            return category === 'general' && (employee.weekendAssignment || {}).sundayGroup === group;
          });

          document.getElementById(`team${team}AGroup`).value = employeeLines(byWeekendGroup('A조'));
          document.getElementById(`team${team}BGroup`).value = employeeLines(byWeekendGroup('B조'));
          [1, 2, 3, 4].forEach(group => {
            document.getElementById(`team${team}Group${group}`).value = employeeLines(bySundayGroup(`${group}조`));
          });
        });
        calculateWeekendPersonnel();
      } catch (error) {
        console.error('기본 편성 기준 주말 인원 요약 오류:', error);
        showResult(error.message || '주말 근무 인원 요약을 계산하지 못했습니다.', 'warning');
      }
    }

    function selectedValues(id) {
      return Array.from(document.getElementById(id).selectedOptions).map(option => option.value);
    }

    function employeeLabel(employee) {
      const duty = employee.securityDuty || {};
      const category = { leader: '조장', general: '일반', special: '특수' }[duty.category] || '미분류';
      const group = duty.category === 'special' && duty.specialGroup ? ` ${duty.specialGroup}조` : '';
      return `${employee.name}${employee.empNo ? ` (${employee.empNo})` : ''} · ${category}${group}`;
    }

    function fillEmployeeSelect(id, preferredCategory) {
      const select = document.getElementById(id);
      select.innerHTML = '';
      const matchingEmployees = assignmentEmployees
        .filter(employee => (employee.securityDuty || {}).category === preferredCategory)
        .slice()
        .sort((a, b) => (a.empNo || '').localeCompare(b.empNo || '', 'ko') || a.name.localeCompare(b.name, 'ko'));
      matchingEmployees
        .forEach(employee => {
          const option = document.createElement('option');
          option.value = employee._id;
          option.textContent = employeeLabel(employee);
          select.appendChild(option);
        });
      if (!matchingEmployees.length) {
        const option = document.createElement('option');
        option.disabled = true;
        option.textContent = '기본 편성에서 해당 역할을 먼저 지정하세요.';
        select.appendChild(option);
      }
    }

    async function loadAssignmentEmployees() {
      try {
        const team = document.getElementById('manualTeam').value;
        const response = await fetch(`/workSchedule/assignment-employees?team=${team}`);
        const result = await response.json();
        if (!result.success) throw new Error(result.message);
        assignmentEmployees = result.data;
        fillEmployeeSelect('manualLeaders', 'leader');
        fillEmployeeSelect('manualGenerals', 'general');
        fillEmployeeSelect('manualSpecials', 'special');
        await loadManualAssignment();
      } catch (error) {
        showResult(error.message || '편성 대상 직원을 불러오지 못했습니다.', 'danger');
      }
    }

    function applySelected(id, values) {
      const selected = new Set((values || []).map(String));
      Array.from(document.getElementById(id).options).forEach(option => {
        option.selected = selected.has(option.value);
      });
    }

