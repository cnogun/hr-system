    function openManualDatePicker() {
      const picker = document.getElementById('manualDate');
      if (!picker) return;
      if (typeof picker.showPicker === 'function') picker.showPicker();
      else picker.click();
    }

    function updateManualDateDay() {
      const dateValue = document.getElementById('manualDate')?.value;
      const dateDisplay = document.getElementById('manualDateDisplay');
      if (!dateDisplay) return;
      if (!dateValue) {
        dateDisplay.value = '';
        return;
      }
      const date = new Date(`${dateValue}T12:00:00`);
      const day = ['일', '월', '화', '수', '목', '금', '토'][date.getDay()];
      dateDisplay.value = `${dateValue} (${day})`;
    }

    function sundayLeaderOrder(dateValue) {
      const target = new Date(`${dateValue}T12:00:00`);
      const anchor = new Date('2026-09-27T12:00:00'); // 조장2 순환 시작일
      const weeks = Math.floor((target - anchor) / (7 * 24 * 60 * 60 * 1000));
      return 2 + (((weeks % 3) + 3) % 3);
    }

    // 확정된 선택조 순환: 1234 → 2341 → 3412 → 4123.
    // 2026-09-27은 전체 순환의 8번째 값인 1조이며, 다음 주는 3조다.
    function sundaySupportGroup(dateValue) {
      const sequence = [1, 2, 3, 4, 2, 3, 4, 1, 3, 4, 1, 2, 4, 1, 2, 3];
      const target = new Date(`${dateValue}T12:00:00`);
      const anchor = new Date('2026-09-27T12:00:00');
      const weeks = Math.floor((target - anchor) / (7 * 24 * 60 * 60 * 1000));
      const index = ((7 + weeks) % sequence.length + sequence.length) % sequence.length;
      return sequence[index];
    }

    // 주간팀은 일요일 주간 조장1·2 / 야간 조장3·4로 시작하고,
    // 같은 팀이 3주 뒤 다시 주간팀이 되면 두 조장 묶음을 서로 바꾼다.
    function sundayDayTeamLeaderIndexes(dateValue, shift) {
      const target = new Date(`${dateValue}T12:00:00`);
      const anchor = new Date('2026-09-27T12:00:00');
      const weeks = Math.floor((target - anchor) / (7 * 24 * 60 * 60 * 1000));
      const threeWeekTurn = Math.floor(weeks / 3);
      const swapped = ((threeWeekTurn % 2) + 2) % 2 === 1;
      const dayIndexes = swapped ? [2, 3] : [0, 1];
      const nightIndexes = swapped ? [0, 1] : [2, 3];
      return shift === 'day' ? dayIndexes : nightIndexes;
    }

    function automaticGroupFor(dateValue, shift, team) {
      const date = new Date(`${dateValue}T12:00:00`);
      const day = date.getDay();
      const schedule = getTeamSchedule(Number(team), getWeekNumber(date));
      if (day === 6) {
        const active = (shift === 'day' && schedule === '초야') || (shift === 'night' && schedule === '심야');
        if (!active) return null;
        const sunday = new Date(date);
        sunday.setDate(sunday.getDate() + 1);
        return { type: 'sunday-exclude', excludedValue: `${sundaySupportGroup(sunday.toISOString().slice(0, 10))}조` };
      }
      if (day === 0) {
        if (schedule === '주간') {
          return { type: 'weekend', values: [shift === 'day' ? 'A조' : 'B조'] };
        }
        const active = (shift === 'day' && schedule === '초야') || (shift === 'night' && schedule === '심야');
        if (!active) return null;
        return { type: 'sunday', values: [`${sundaySupportGroup(dateValue)}조`] };
      }
      return null;
    }

    function updateSundayAssignmentBreakdown() {
      const panel = document.getElementById('sundayAssignmentBreakdown');
      const dateValue = document.getElementById('manualDate')?.value;
      const shift = document.getElementById('manualShift')?.value || 'day';
      const selectedTeam = Number(document.getElementById('manualTeam')?.value || 1);
      if (!panel || !dateValue) return;

      const date = new Date(`${dateValue}T12:00:00`);
      if (date.getDay() !== 0) {
        panel.classList.add('d-none');
        panel.innerHTML = '';
        return;
      }

      const weekNumber = getWeekNumber(date);
      const teams = [1, 2, 3];
      const mainTeam = teams.find(team => getTeamSchedule(team, weekNumber) === '주간');
      const supportSchedule = shift === 'day' ? '초야' : '심야';
      const supportTeam = teams.find(team => getTeamSchedule(team, weekNumber) === supportSchedule);
      const mainGroup = shift === 'day' ? 'A조' : 'B조';
      const supportGroup = sundaySupportGroup(dateValue);
      const currentType = selectedTeam === mainTeam
        ? `현재 표시: 주간팀 보안${mainTeam}팀 ${mainGroup} 19명`
        : selectedTeam === supportTeam
          ? `현재 표시: 지원팀 보안${supportTeam}팀 ${supportGroup}조 9명`
          : `현재 표시: 보안${selectedTeam}팀은 이 근무대 비근무`;

      panel.innerHTML = `
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
          <div>
            <span class="fw-bold"><i class="fa-solid fa-people-group me-1"></i>일요일 ${shift === 'day' ? '주간' : '야간'} 전체 28명</span>
            <span class="ms-2">주간팀 보안${mainTeam}팀 ${mainGroup} 19명
              <small class="text-muted">(조장2·일반12·특수5)</small></span>
            <span class="mx-1">+</span>
            <span>지원팀 보안${supportTeam}팀 ${supportGroup}조 9명
              <small class="text-muted">(조장1·일반6·특수2)</small></span>
          </div>
          <span class="badge ${selectedTeam === mainTeam ? 'bg-primary' : selectedTeam === supportTeam ? 'bg-success' : 'bg-secondary'}">${currentType}</span>
        </div>`;
      panel.classList.remove('d-none');
    }

    function applyAutomaticAssignment(showMessage = false) {
      const dateValue = document.getElementById('manualDate').value;
      const shift = document.getElementById('manualShift').value;
      const team = document.getElementById('manualTeam').value;
      if (!dateValue || !assignmentEmployees.length) return;
      resetDirectSpecialSelectionButton();
      updateSundayAssignmentBreakdown();
      const date = new Date(`${dateValue}T12:00:00`);
      const groupRule = automaticGroupFor(dateValue, shift, team);
      const isIncluded = employee => {
        if (!groupRule) return false;
        const assignment = employee.weekendAssignment || {};
        if (groupRule.type === 'sunday-exclude') {
          return assignment.sundayGroup !== groupRule.excludedValue;
        }
        const value = groupRule.type === 'weekend' ? assignment.weekendGroup : assignment.sundayGroup;
        return groupRule.values.includes(value);
      };

      const sortedLeaders = assignmentEmployees
        .filter(employee => (employee.securityDuty || {}).category === 'leader')
        .sort((a, b) => (a.empNo || '').localeCompare(b.empNo || '', 'ko') || a.name.localeCompare(b.name, 'ko'));
      let leaders = [];
      if (date.getDay() === 6 && groupRule) {
        // 토요일에는 조장1을 포함하고, 다음 날 일요일 지원조장 한 명만 제외한다.
        const sunday = new Date(date);
        sunday.setDate(sunday.getDate() + 1);
        const supportLeaderOrder = sundayLeaderOrder(sunday.toISOString().slice(0, 10));
        leaders = sortedLeaders.filter((employee, index) => index !== supportLeaderOrder - 1).slice(0, 3);
      } else if (date.getDay() === 0 && groupRule) {
        const schedule = getTeamSchedule(Number(team), getWeekNumber(date));
        if (schedule === '주간') {
          leaders = sundayDayTeamLeaderIndexes(dateValue, shift)
            .map(index => sortedLeaders[index])
            .filter(Boolean);
        } else {
          const order = sundayLeaderOrder(dateValue);
          leaders = sortedLeaders[order - 1] ? [sortedLeaders[order - 1]] : [];
        }
      }
      const sortedByCategory = category => assignmentEmployees
        .filter(employee => (employee.securityDuty || {}).category === category)
        .sort((a, b) => (a.empNo || '').localeCompare(b.empNo || '', 'ko') || a.name.localeCompare(b.name, 'ko'));

      // 일반경비는 일반 1~4조, 특수경비는 특수 1~5조를 각각 기준으로 사용한다.
      // 저장된 조 편성이 정확히 6/2가 아니어도 지원조는 반드시 일반6·특수2로 맞춘다.
      // 선택조에 속한 직원을 우선하고, 부족하면 같은 역할의 다른 직원으로 채운다.
      const supportMembers = (category, limit, supportGroup) => {
        const all = sortedByCategory(category);
        const supportGroupNumber = Number(String(supportGroup).replace('조', ''));
        const preferred = all.filter(employee => category === 'special'
          ? Number((employee.securityDuty || {}).specialGroup) === supportGroupNumber
          : (employee.weekendAssignment || {}).sundayGroup === supportGroup
        );
        const preferredIds = new Set(preferred.map(employee => String(employee._id)));
        return preferred.concat(all.filter(employee => !preferredIds.has(String(employee._id)))).slice(0, limit);
      };

      let generals = [];
      let specials = [];
      if (groupRule && groupRule.type === 'weekend') {
        generals = sortedByCategory('general').filter(isIncluded);
        specials = sortedByCategory('special').filter(isIncluded);
      } else if (groupRule && groupRule.type === 'sunday') {
        const supportGroup = groupRule.values[0];
        generals = supportMembers('general', 6, supportGroup);
        specials = supportMembers('special', 2, supportGroup);
      } else if (groupRule && groupRule.type === 'sunday-exclude') {
        const supportGenerals = new Set(supportMembers('general', 6, groupRule.excludedValue).map(employee => String(employee._id)));
        const supportSpecials = new Set(supportMembers('special', 2, groupRule.excludedValue).map(employee => String(employee._id)));
        generals = sortedByCategory('general').filter(employee => !supportGenerals.has(String(employee._id)));
        specials = sortedByCategory('special').filter(employee => !supportSpecials.has(String(employee._id)));
      }

      applySelected('manualLeaders', leaders.map(employee => employee._id));
      applySelected('manualGenerals', generals.map(employee => employee._id));
      applySelected('manualSpecials', specials.map(employee => employee._id));
      document.getElementById('manualNote').value = '';
      const status = document.getElementById('assignmentStatus');
      if (date.getDay() === 6) {
        const sunday = new Date(date);
        sunday.setDate(sunday.getDate() + 1);
        status.textContent = `기본 명단 · 일요일 지원조 제외`;
      } else if (date.getDay() === 0 && groupRule?.type === 'weekend') {
        const mainGroup = shift === 'day' ? 'A조' : 'B조';
        status.textContent = `주간팀 ${mainGroup} · 19명 (조장2·일반12·특수5)`;
      } else if (date.getDay() === 0 && groupRule?.type === 'sunday') {
        status.textContent = `지원팀 ${groupRule.values[0]} · 9명 (조장1·일반6·특수2)`;
      } else if (date.getDay() === 0) {
        status.textContent = '해당 근무대 비근무팀';
      } else {
        const schedule = getTeamSchedule(Number(team), getWeekNumber(date));
        status.textContent = schedule === '주간'
          ? '기본 명단 · 주간팀 조장 2명'
          : `기본 명단 · 지원조장${sundayLeaderOrder(dateValue)}`;
      }
      status.className = 'badge bg-light text-primary';
      document.getElementById('confirmedRosterPanel').classList.add('d-none');
      updateManualCounts();
      if (showMessage) showResult('기본 명단을 다시 불러왔습니다. 확인 후 근무명단 확정을 누르면 기존 확정명단이 교체됩니다.', 'info');
    }

    function resetConfirmedAssignment() {
      document.getElementById('confirmedRosterPanel').classList.add('d-none');
      const status = document.getElementById('assignmentStatus');
      status.textContent = '확정명단 재설정 중';
      status.className = 'badge bg-warning text-dark';
      showResult('현재 확정명단을 수정할 수 있습니다. 인원을 다시 선택하거나 기본 명단을 불러온 뒤 근무명단 확정을 눌러주세요.', 'warning');
    }

    function escapeRosterText(value) {
      return String(value ?? '').replace(/[&<>"']/g, character => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
      })[character]);
    }

    function renderConfirmedRoster(data) {
      const employeeById = new Map(assignmentEmployees.map(employee => [String(employee._id), employee]));
      const categories = [
        ['조장', data.leaders || [], 'primary'],
        ['일반', data.generals || [], 'success'],
        ['특수', data.specials || [], 'warning']
      ];
      const rows = [];
      categories.forEach(([label, ids, color]) => {
        ids.forEach(id => {
          const employee = employeeById.get(String(id));
          if (!employee) return;
          const duty = employee.securityDuty || {};
          const assignment = employee.weekendAssignment || {};
          const groups = [];
          if (duty.category === 'leader') {
            const sortedLeaders = assignmentEmployees
              .filter(item => (item.securityDuty || {}).category === 'leader')
              .sort((a, b) => (a.empNo || '').localeCompare(b.empNo || '', 'ko') || a.name.localeCompare(b.name, 'ko'));
            const leaderIndex = sortedLeaders.findIndex(item => String(item._id) === String(employee._id));
            if (leaderIndex >= 0) groups.push(`조장${leaderIndex + 1}`);
          }
          if (assignment.weekendGroup && assignment.weekendGroup !== 'none') groups.push(assignment.weekendGroup);
          if (assignment.sundayGroup && assignment.sundayGroup !== 'none') groups.push(assignment.sundayGroup);
          if (duty.category === 'special' && duty.specialGroup) groups.push(`특수${duty.specialGroup}조`);
          rows.push(`<tr>
            <td><span class="badge bg-${color}${color === 'warning' ? ' text-dark' : ''}">${label}</span></td>
            <td>${escapeRosterText(employee.empNo || '-')}</td>
            <td class="fw-semibold">${escapeRosterText(employee.name)}</td>
            <td>${escapeRosterText(groups.join(' · ') || '-')}</td>
            <td><span class="text-success"><i class="fa-solid fa-check me-1"></i>확정</span></td>
          </tr>`);
        });
      });
      document.getElementById('confirmedRosterBody').innerHTML = rows.join('') ||
        '<tr><td colspan="5" class="text-center text-muted py-3">확정된 인원이 없습니다.</td></tr>';
      document.getElementById('confirmedTotalCount').textContent = `${rows.length}명`;
      const updatedAt = data.updatedAt ? new Date(data.updatedAt).toLocaleString('ko-KR') : '';
      document.getElementById('confirmedMeta').textContent = updatedAt ? `확정 ${updatedAt}` : '확정 완료';
      document.getElementById('confirmedNote').textContent = data.note
        ? `변경 사유: ${data.note}`
        : '기본편성 명단을 변경 없이 확정했습니다.';
      document.getElementById('confirmedRosterPanel').classList.remove('d-none');
    }

    async function loadManualAssignment() {
      const date = document.getElementById('manualDate').value;
      if (!date) return;
      updateSundayAssignmentBreakdown();
      try {
        const params = new URLSearchParams({
          date,
          shift: document.getElementById('manualShift').value,
          team: document.getElementById('manualTeam').value
        });
        const response = await fetch(`/workSchedule/manual-assignment?${params}`);
        const result = await response.json();
        if (!result.success) throw new Error(result.message);
        const data = result.data;
        if (!data) {
          applyAutomaticAssignment(false);
          return;
        }
        applySelected('manualLeaders', data.leaders);
        applySelected('manualGenerals', data.generals);
        applySelected('manualSpecials', data.specials);
        document.getElementById('manualNote').value = data.note || '';
        const status = document.getElementById('assignmentStatus');
        status.textContent = data.note ? '변경 후 확정 명단' : '확정 명단';
        status.className = 'badge bg-success';
        renderConfirmedRoster(data);
        updateManualCounts();
      } catch (error) {
        showResult(error.message || '수동 편성을 불러오지 못했습니다.', 'danger');
      }
    }

    async function saveManualAssignment() {
      const body = {
        date: document.getElementById('manualDate').value,
        shift: document.getElementById('manualShift').value,
        team: Number(document.getElementById('manualTeam').value),
        leaders: selectedValues('manualLeaders'),
        generals: selectedValues('manualGenerals'),
        specials: selectedValues('manualSpecials'),
        note: document.getElementById('manualNote').value
      };
      try {
        // 일요일 주간팀을 확정할 때 같은 근무대의 미확정 지원팀도 함께 확정한다.
        const workDate = new Date(`${body.date}T12:00:00`);
        if (workDate.getDay() === 0 && getTeamSchedule(body.team, getWeekNumber(workDate)) === '주간') {
          const supportSchedule = body.shift === 'day' ? '초야' : '심야';
          const supportTeam = [1, 2, 3].find(team => getTeamSchedule(team, getWeekNumber(workDate)) === supportSchedule);
          if (supportTeam) {
            const existingResponse = await fetch(`/workSchedule/manual-assignment?${new URLSearchParams({ date: body.date, shift: body.shift, team: String(supportTeam) })}`);
            const existingResult = await existingResponse.json();
            if (!existingResult.success) throw new Error(existingResult.message);
            if (!existingResult.data) {
              const membersResponse = await fetch(`/workSchedule/assignment-employees?team=${supportTeam}`);
              const membersResult = await membersResponse.json();
              if (!membersResult.success) throw new Error(membersResult.message);
              const members = membersResult.data || [];
              const sorted = category => members.filter(item => item.securityDuty?.category === category)
                .sort((a, b) => (a.empNo || '').localeCompare(b.empNo || '', 'ko') || a.name.localeCompare(b.name, 'ko'));
              const group = `${sundaySupportGroup(body.date)}조`;
              const preferred = (category, limit) => {
                const all = sorted(category);
                const first = all.filter(item => category === 'special'
                  ? Number(item.securityDuty?.specialGroup) === Number(group.replace('조', ''))
                  : item.weekendAssignment?.sundayGroup === group);
                const used = new Set(first.map(item => String(item._id)));
                return first.concat(all.filter(item => !used.has(String(item._id)))).slice(0, limit).map(item => item._id);
              };
              const leader = sorted('leader')[sundayLeaderOrder(body.date) - 1];
              body.support = { team: supportTeam, leaders: leader ? [leader._id] : [], generals: preferred('general', 6), specials: preferred('special', 2) };
              if (body.support.leaders.length !== 1 || body.support.generals.length !== 6 || body.support.specials.length !== 2) {
                throw new Error(`보안${supportTeam}팀 지원조 9명을 구성할 수 없습니다. 기본편성을 확인해주세요.`);
              }
            }
          }
        }
        const response = await fetch('/workSchedule/manual-assignment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const result = await response.json();
        if (!result.success) throw new Error(result.message);
        showResult(result.message, 'success');
        await loadManualAssignment();
        await loadConfirmedAssignments(true);
      } catch (error) {
        showResult(error.message || '수동 편성을 저장하지 못했습니다.', 'danger');
      }
    }

    async function loadConfirmedAssignments(forceRefresh = false) {
      if (confirmedAssignmentsLoading) return;
      confirmedAssignmentsLoading = true;
      const body = document.getElementById('confirmedAssignmentsListBody');
      if (forceRefresh && body) {
        body.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">확정명단을 새로 불러오는 중입니다.</td></tr>';
      }
      try {
        const response = await fetch(`/workSchedule/manual-assignments${forceRefresh ? `?t=${Date.now()}` : ''}`);
        const result = await response.json();
        if (handleHolidayAuth(response, result)) return;
        if (!result.success) throw new Error(result.message);
        renderConfirmedAssignmentsList(result.data || []);
      } catch (error) {
        if (body) body.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-4">${escapeRosterText(error.message || '확정명단을 불러오지 못했습니다.')}</td></tr>`;
      } finally {
        confirmedAssignmentsLoading = false;
      }
    }

    function renderConfirmedAssignmentsList(assignments) {
      const body = document.getElementById('confirmedAssignmentsListBody');
      if (!body) return;
      if (!assignments.length) {
        body.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">확정된 근무명단이 없습니다.</td></tr>';
        return;
      }
      window.confirmedAssignmentItems = assignments;
      const groups = new Map();
      assignments.forEach(item => {
        const key = `${item.date}|${item.shift}`;
        if (!groups.has(key)) groups.set(key, { date: item.date, shift: item.shift, teams: [] });
        groups.get(key).teams.push(item);
      });
      body.innerHTML = Array.from(groups.values()).map(group => {
        const date = new Date(`${group.date}T12:00:00`);
        const day = ['일', '월', '화', '수', '목', '금', '토'][date.getDay()];
        const weekNumber = getWeekNumber(date);
        const mainTeamNumber = [1, 2, 3].find(team => getTeamSchedule(team, weekNumber) === '주간');
        const supportSchedule = group.shift === 'day' ? '초야' : '심야';
        const supportTeamNumber = [1, 2, 3].find(team => getTeamSchedule(team, weekNumber) === supportSchedule);
        const teams = group.teams.sort((a, b) => Number(a.team) - Number(b.team));
        const mainTeam = teams.find(item => Number(item.team) === mainTeamNumber);
        const supportTeam = teams.find(item => Number(item.team) === supportTeamNumber);
        const total = teams.reduce((sum, item) => sum + Number(item.totalCount), 0);
        const leader = teams.reduce((sum, item) => sum + Number(item.leaderCount), 0);
        const general = teams.reduce((sum, item) => sum + Number(item.generalCount), 0);
        const special = teams.reduce((sum, item) => sum + Number(item.specialCount), 0);
        const teamCell = item => item
          ? `<span class="fw-semibold">보안${Number(item.team)}팀</span> <span class="badge bg-secondary">${Number(item.totalCount)}명</span>`
          : '<span class="text-muted">—</span>';
        return `<tr>
          <td class="fw-semibold text-nowrap">${escapeRosterText(group.date)} (${day})</td>
          <td><span class="badge ${group.shift === 'day' ? 'bg-primary' : 'bg-dark'}">${group.shift === 'day' ? '주간' : '야간'}</span></td>
          <td class="text-nowrap">${teamCell(mainTeam)}${!mainTeam ? '<br><small class="text-danger">미확정</small>' : ''}</td>
          <td class="text-nowrap">${teamCell(supportTeam)}${!supportTeam ? '<br><small class="text-danger">미확정</small>' : ''}</td>
          <td class="text-nowrap"><strong>전체 ${total}명</strong><br><small class="text-muted">조장 ${leader} · 일반 ${general} · 특수 ${special}</small>${teams.filter(item => item !== mainTeam && item !== supportTeam).length ? `<br><small>기타: ${teams.filter(item => item !== mainTeam && item !== supportTeam).map(teamCell).join(' · ')}</small>` : ''}${date.getDay() === 0 && (Number(mainTeam?.totalCount || 0) !== 19 || Number(supportTeam?.totalCount || 0) !== 9) ? '<br><small class="text-danger">기본편성 기준 주간팀 19명 + 지원팀 9명을 확인하세요.</small>' : ''}</td>
          <td class="text-center text-nowrap"><div class="d-inline-flex gap-1"><button class="btn btn-outline-primary btn-sm" type="button" onclick="openConfirmedAllRoster('${group.date}', '${group.shift}')"><i class="fa-solid fa-eye me-1"></i>보기</button><button class="btn btn-outline-danger btn-sm" type="button" onclick="openConfirmedDelete('${group.date}', '${group.shift}')"><i class="fa-solid fa-trash-can me-1"></i>삭제</button></div></td>
        </tr>`;
      }).join('');
    }

    function openConfirmedDelete(date, shift) {
      const teams = (window.confirmedAssignmentItems || []).filter(item => item.date === date && item.shift === shift);
      const choices = document.getElementById('confirmedDeleteChoices');
      document.getElementById('confirmedDeleteTitle').textContent = `${date} ${shift === 'day' ? '주간' : '야간'} 확정명단 삭제`;
      choices.innerHTML = teams.map((item, index) => `<button class="btn btn-outline-danger text-start" type="button" data-index="${index}">보안${Number(item.team)}팀 · ${Number(item.totalCount)}명 삭제</button>`).join('');
      choices.querySelectorAll('button').forEach(button => button.addEventListener('click', () => {
        const item = teams[Number(button.dataset.index)];
        deleteConfirmedAssignment(item.scheduleId, item.assignmentId, date, Number(item.team));
      }));
      bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmedDeleteModal')).show();
    }

