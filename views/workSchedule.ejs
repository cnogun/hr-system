    async function deleteConfirmedAssignment(scheduleId, assignmentId, date, team) {
      if (!confirm(`${date} 보안${team}팀 확정 근무명단을 삭제하시겠습니까?\n삭제한 명단은 복구할 수 없습니다.`)) return;
      try {
        const response = await fetch(`/workSchedule/manual-assignments/${scheduleId}/${assignmentId}`, { method: 'DELETE' });
        const result = await response.json();
        if (handleHolidayAuth(response, result)) return;
        if (!result.success) throw new Error(result.message);
        bootstrap.Modal.getInstance(document.getElementById('confirmedDeleteModal'))?.hide();
        showResult(result.message, 'success');
        await loadConfirmedAssignments(true);
      } catch (error) {
        showResult(error.message || '확정 근무명단을 삭제하지 못했습니다.', 'danger');
      }
    }

