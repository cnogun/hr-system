         // 메시지 표시
     function showMessage(message, type) {
       const resultDiv = document.getElementById('saveResult');
       resultDiv.style.display = 'block';
       resultDiv.className = `alert alert-${type} mt-3`;
       resultDiv.innerHTML = `
         <i class="fa-solid fa-${type === 'success' ? 'check-circle' : type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>
         ${message}
       `;
       
       setTimeout(() => {
         resultDiv.style.display = 'none';
       }, 3000);
     }

     
     
     // 요일 반환 함수
     function getDayOfWeek(dateString) {
       const date = new Date(dateString);
       const days = ['일', '월', '화', '수', '목', '금', '토'];
       return days[date.getDay()];
     }
     
     
     // 날짜 포맷팅 함수
     function formatDate(dateString) {
       const date = new Date(dateString);
       const year = date.getFullYear();
       const month = String(date.getMonth() + 1).padStart(2, '0');
       const day = String(date.getDate()).padStart(2, '0');
       return `${year}-${month}-${day}`;
     }
     
     // 입력 필드용 날짜 포맷팅
     function formatDateForInput(dateString) {
       const date = new Date(dateString);
       const year = date.getFullYear();
       const month = String(date.getMonth() + 1).padStart(2, '0');
       const day = String(date.getDate()).padStart(2, '0');
       return `${year}-${month}-${day}`;
     }
     
     // 근무 순환 로직 안내 토글 함수
     function toggleWorkLogicInfo() {
       const infoDiv = document.getElementById('workLogicInfo');
       if (infoDiv.style.display === 'none') {
         infoDiv.style.display = 'block';
       } else {
         infoDiv.style.display = 'none';
       }
     }
     

