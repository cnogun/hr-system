<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>로그인 전 공지사항</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { min-height: 100vh; background: linear-gradient(135deg, #f8fafc, #e2eafc); color: #263448; }
    .notice-wrap { max-width: 720px; margin: 0 auto; padding: clamp(1.5rem, 5vw, 4rem) 1rem; }
    .notice-panel { background: #fff; border: 1px solid #e2e8f0; border-radius: 18px; box-shadow: 0 12px 36px rgba(26, 42, 70, .08); overflow: hidden; }
    .notice-head { padding: 1.75rem 2rem 1rem; }
    .notice-list { max-height: 60vh; overflow-y: auto; padding: 0 2rem; }
    .notice-item { padding: 1.4rem 0; border-top: 1px solid #e9eef5; }
    .notice-content { white-space: pre-wrap; overflow-wrap: anywhere; line-height: 1.7; color: #475569; }
    .notice-actions { padding: 1rem 2rem 1.75rem; border-top: 1px solid #e9eef5; }
    @media (max-width: 576px) { .notice-head, .notice-list, .notice-actions { padding-left: 1.25rem; padding-right: 1.25rem; } }
  </style>
</head>
<body>
  <main class="notice-wrap">
    <section class="notice-panel" aria-label="시스템 알림 공지">
      <header class="notice-head">
        <span class="badge rounded-pill text-bg-primary mb-3">시스템 공지</span>
      </header>
      <div class="notice-list">
        <% notices.forEach(function(notice) { %>
          <article class="notice-item">
            <h2 class="h5 fw-semibold"><%= notice.title %></h2>
            <div class="notice-content"><%= notice.content %></div>
          </article>
        <% }) %>
      </div>
      <div class="notice-actions">
        <form action="/auth/login/notices/close" method="POST">
          <button type="submit" class="btn btn-primary w-100 py-2">닫기</button>
        </form>
      </div>
    </section>
  </main>
</body>
</html>
