<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>직원 정보 수정</title>
  <style>
    .employee-picker{width:min(100% - 32px,760px);margin:24px auto 40px}.employee-picker h1{margin:0 0 14px;color:#14243c;font-size:1.5rem;font-weight:750}.employee-picker-card{display:grid;grid-template-columns:auto minmax(260px,1fr) auto;align-items:center;gap:12px;padding:15px 17px;border:1px solid #e2e8f0;border-radius:10px;background:#fff;box-shadow:0 2px 8px #0f172a09}.employee-picker-label{margin:0;color:#334155;font-size:.9rem;font-weight:650;white-space:nowrap}.employee-picker .form-select{min-height:38px;font-size:.9rem;border-radius:7px}.employee-picker .btn{min-height:38px;padding:7px 15px;border-radius:7px;white-space:nowrap}@media(max-width:640px){.employee-picker{margin-top:16px}.employee-picker-card{grid-template-columns:1fr;align-items:stretch;padding:14px;gap:8px}.employee-picker .btn{width:100%}}
  </style>
</head>
<body>
  <%- include('header') %>
  <main class="employee-picker"><h1>직원 정보 수정</h1><div class="employee-picker-card"><label for="employeeSelect" class="employee-picker-label">수정할 직원</label><select id="employeeSelect" class="form-select" onchange="goEditEmployee(this.value)"><option value="">직원을 선택하세요</option><% if (typeof employees !== 'undefined') { employees.forEach(function(emp) { %><option value="<%= emp._id %>"><%= emp.name %> (<%= emp.empNo || '-' %>, <%= emp.department || '' %>)</option><% }); } %></select><a href="/employees" class="btn btn-outline-secondary">목록으로</a></div></main>
  <%- include('footer') %>
  <script>
    function goEditEmployee(id) {
      if (id) {
        window.location.href = '/employees/' + id + '/edit';
      }
    }
  </script>
</body>
</html>
