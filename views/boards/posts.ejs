<!--
  파일명: boards/posts.ejs
  목적: 게시판별 게시글 목록 페이지
  기능:
  - 게시글 목록 표시 및 페이징
  - 게시글 검색 및 정렬
  - 게시글 작성 버튼 (권한별)
  - 공지사항 우선 표시
  - 반응형 테이블 디자인
-->
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title><%= board.name %></title>
  <style>
    :root { --board-navy: #12335c; --board-blue: #1d6fb1; --board-bg: #f3f6fa; --board-border: #d9e3ef; --board-muted: #6b7f9f; }
    body { background: var(--board-bg); color: #102f59; }
    .board-page { width: 100% !important; max-width: 1120px; margin: 0 auto; padding: 26px 28px 52px; }
    .board-page h2 { margin: 0; color: #082d60; font-size: 1.55rem; font-weight: 750; letter-spacing: -.02em; }
    .board-page .card { border: 1px solid var(--board-border); border-radius: 14px; box-shadow: 0 6px 18px rgba(25, 55, 90, .045); overflow: hidden; }
    .board-page .card-header { min-height: 54px; padding: 12px 18px; background: #fff; border-bottom: 1px solid #e5ebf3; }
    .board-page .card-body { background: #fff; }
    .board-page .form-control, .board-page .form-select, .board-page .input-group-text { min-height: 42px; border-color: #cad8e8; font-size: .9rem; }
    .board-page .btn { min-height: 38px; border-radius: 8px; font-size: .86rem; font-weight: 650; }
    .board-page .btn-primary { background: var(--board-blue); border-color: var(--board-blue); }
    .board-page .table { color: #15365f; font-size: .86rem; }
    .board-page .table > :not(caption) > * > * { padding: 12px 13px; border-color: #e2e9f1; vertical-align: middle; }
    .board-page .table-light th { background: #f2f6fb; color: #31547d; font-size: .8rem; font-weight: 700; white-space: nowrap; }
    .board-page .table tbody tr:hover > * { background: #f8fbff; }
    .board-page .table a { color: #123f74; font-weight: 600; }
    .post-date { white-space: nowrap; }
    .post-select { width: 42px; text-align: center; }
    @media (max-width: 767.98px) {
      .board-page { width: 100%; padding: 18px 14px 38px; }
      .board-page h2 { font-size: 1.3rem; }
    }
  </style>
</head>
<body>
  <%- include('../header') %>
  
  <div class="container-fluid board-page">
    <div class="row">
      <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
          <h2>
            <% if (board.type === 'notice') { %>
              <i class="fas fa-bullhorn text-danger"></i>
            <% } else if (board.type === 'free') { %>
              <i class="fas fa-comments text-primary"></i>
            <% } else { %>
              <i class="fas fa-users text-success"></i>
            <% } %>
            <%= board.name %>
          </h2>
          <div class="d-flex gap-2">
            <% if (session.userRole === 'admin') { %>
            <a href="/boards/admin/reports" class="btn btn-outline-danger btn-sm">
              <i class="fas fa-flag"></i> 신고 관리
              <% if (pendingReports > 0) { %>
                <span class="badge bg-danger ms-1"><%= pendingReports %></span>
              <% } %>
            </a>
            <% } %>
            <a href="/boards" class="btn btn-secondary btn-sm">
              <i class="fas fa-arrow-left"></i> 목록
            </a>
            <% if (board.type !== 'notice' || session.userRole === 'admin') { %>
            <a href="/boards/<%= board._id %>/write" class="btn btn-primary btn-sm">
              <i class="fas fa-pen"></i> 글쓰기
            </a>
            <% } %>
          </div>
        </div>

        <% if (session.message && !session.message.includes('유니폼')) { %>
          <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= session.message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
          <% delete session.message; %>
        <% } %>

        <!-- 검색 및 정렬 -->
        <div class="card mb-4">
          <div class="card-body">
            <form method="GET" class="row g-3">
              <div class="col-md-5">
                <div class="input-group">
                  <span class="input-group-text">
                    <i class="fas fa-search"></i>
                  </span>
                  <input type="text" name="search" class="form-control" placeholder="제목, 내용, 작성자, 태그 검색" value="<%= search %>">
                  <button type="submit" class="btn btn-outline-primary">
                    검색
                  </button>
                </div>
                <small class="text-muted">여러 단어로 검색 가능 (예: 보안 업무)</small>
              </div>
              <div class="col-md-3">
                <select name="sort" class="form-select">
                  <option value="latest" <%= sort === 'latest' ? 'selected' : '' %>>최신순</option>
                  <option value="views" <%= sort === 'views' ? 'selected' : '' %>>조회순</option>
                  <option value="likes" <%= sort === 'likes' ? 'selected' : '' %>>추천순</option>
                </select>
              </div>
              <div class="col-md-2">
                <a href="/boards/<%= board._id %>" class="btn btn-outline-secondary w-100">
                  <i class="fas fa-refresh"></i> 초기화
                </a>
              </div>
              <div class="col-md-2">
                <button type="button" class="btn btn-outline-info w-100" data-bs-toggle="modal" data-bs-target="#searchHelpModal">
                  <i class="fas fa-question-circle"></i> 검색도움말
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- 검색 도움말 모달 -->
        <div class="modal fade" id="searchHelpModal" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title">검색 도움말</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <h6>검색 방법:</h6>
                <ul>
                  <li><strong>단어 검색:</strong> "보안", "업무" 등</li>
                  <li><strong>복합 검색:</strong> "보안 업무" (여러 단어)</li>
                  <li><strong>태그 검색:</strong> 게시글에 설정된 태그로 검색</li>
                  <li><strong>작성자 검색:</strong> 작성자 이름으로 검색</li>
                </ul>
                <h6>검색 범위:</h6>
                <ul>
                  <li>게시글 제목</li>
                  <li>게시글 내용</li>
                  <li>작성자 이름</li>
                  <li>태그</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- 게시글 목록 -->
        <div class="card">
          <form id="bulkDeleteForm" method="POST" action="/boards/<%= board._id %>/posts/bulk-delete">
          <div class="card-header">
            <div class="row align-items-center">
              <div class="col-md-6">
                <strong>총 <%= posts.length %>개의 게시글</strong>
              </div>
              <div class="col-md-6 text-end">
                <% if (session.userRole === 'admin' && posts.length > 0) { %>
                  <button id="bulkDeleteButton" type="submit" class="btn btn-outline-danger btn-sm me-2" disabled>
                    <i class="fas fa-trash"></i> 선택 삭제
                  </button>
                <% } %>
              </div>
            </div>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <% if (session.userRole === 'admin') { %>
                      <th class="post-select">
                        <input id="selectAllPosts" class="form-check-input" type="checkbox" aria-label="게시글 전체 선택">
                      </th>
                    <% } %>
                    <th style="width: 10%;">번호</th>
                    <th style="width: 50%;">제목</th>
                    <th style="width: 15%;">작성자</th>
                    <th style="width: 10%;">조회</th>
                    <th style="width: 10%;">추천</th>
                    <th style="width: 15%;">작성일</th>
                  </tr>
                </thead>
                <tbody>
                  <% posts.forEach((post, index) => { %>
                    <tr>
                      <% if (session.userRole === 'admin') { %>
                        <td class="post-select">
                          <input class="form-check-input post-checkbox" type="checkbox" name="postIds" value="<%= post._id %>" aria-label="<%= post.title %> 선택">
                        </td>
                      <% } %>
                      <td>
                        <% if (post.isNotice) { %>
                          <span class="badge bg-danger">공지</span>
                        <% } else { %>
                          <%= (currentPage - 1) * 10 + index + 1 %>
                        <% } %>
                      </td>
                      <td>
                        <a href="/boards/<%= board._id %>/<%= post._id %>" class="text-decoration-none">
                          <%= post.title %>
                          <% if (post.attachments && post.attachments.length > 0) { %>
                            <i class="fas fa-paperclip text-muted"></i>
                          <% } %>
                          <% if (post.comments && post.comments.length > 0) { %>
                            <span class="text-primary">[<%= post.comments.length %>]</span>
                          <% } %>
                        </a>
                        <% if (post.isAnonymous) { %>
                          <span class="badge bg-secondary">익명</span>
                        <% } %>
                      </td>
                      <td><%= post.authorName %></td>
                      <td><%= post.views %></td>
                      <td>
                        <span class="text-success">👍 <%= post.likes ? post.likes.length : 0 %></span>
                        <span class="text-danger">👎 <%= post.dislikes ? post.dislikes.length : 0 %></span>
                      </td>
                      <td class="post-date"><%= new Date(post.createdAt).toLocaleDateString('ko-KR') %></td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
          </form>
        </div>

        <% if (posts.length === 0) { %>
          <div class="text-center py-5">
            <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">등록된 게시글이 없습니다.</h5>
            <p class="text-muted">첫 번째 게시글을 작성해보세요!</p>
            <a href="/boards/<%= board._id %>/write" class="btn btn-primary">
              <i class="fas fa-pen"></i> 글쓰기
            </a>
          </div>
        <% } %>

        <!-- 페이지네이션 -->
        <% if (totalPages > 1) { %>
          <nav aria-label="게시글 페이지네이션" class="mt-4">
            <ul class="pagination justify-content-center">
              <% if (currentPage > 1) { %>
                <li class="page-item">
                  <a class="page-link" href="/boards/<%= board._id %>?page=<%= currentPage - 1 %>&search=<%= search %>&sort=<%= sort %>">
                    <i class="fas fa-chevron-left"></i>
                  </a>
                </li>
              <% } %>
              
              <% for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) { %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                  <a class="page-link" href="/boards/<%= board._id %>?page=<%= i %>&search=<%= search %>&sort=<%= sort %>">
                    <%= i %>
                  </a>
                </li>
              <% } %>
              
              <% if (currentPage < totalPages) { %>
                <li class="page-item">
                  <a class="page-link" href="/boards/<%= board._id %>?page=<%= currentPage + 1 %>&search=<%= search %>&sort=<%= sort %>">
                    <i class="fas fa-chevron-right"></i>
                  </a>
                </li>
              <% } %>
            </ul>
          </nav>
        <% } %>
      </div>
    </div>
  </div>



  <%- include('../footer') %>
  <% if (session.userRole === 'admin') { %>
  <script>
    (() => {
      const form = document.getElementById('bulkDeleteForm');
      const selectAll = document.getElementById('selectAllPosts');
      const checkboxes = Array.from(document.querySelectorAll('.post-checkbox'));
      const deleteButton = document.getElementById('bulkDeleteButton');
      if (!form || !selectAll || !deleteButton) return;

      const syncSelection = () => {
        const selectedCount = checkboxes.filter(checkbox => checkbox.checked).length;
        selectAll.checked = checkboxes.length > 0 && selectedCount === checkboxes.length;
        selectAll.indeterminate = selectedCount > 0 && selectedCount < checkboxes.length;
        deleteButton.disabled = selectedCount === 0;
        deleteButton.innerHTML = `<i class="fas fa-trash"></i> 선택 삭제${selectedCount ? ` (${selectedCount})` : ''}`;
      };

      selectAll.addEventListener('change', () => {
        checkboxes.forEach(checkbox => { checkbox.checked = selectAll.checked; });
        syncSelection();
      });
      checkboxes.forEach(checkbox => checkbox.addEventListener('change', syncSelection));
      form.addEventListener('submit', event => {
        const selectedCount = checkboxes.filter(checkbox => checkbox.checked).length;
        if (!selectedCount || !window.confirm(`선택한 게시글 ${selectedCount}건을 삭제하시겠습니까?\n삭제한 게시글은 복구할 수 없습니다.`)) {
          event.preventDefault();
        }
      });
    })();
  </script>
  <% } %>
</body>
</html>
