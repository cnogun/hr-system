<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>게시판 신고 관리</title>
  <style>
    :root { --report-navy:#12335c; --report-blue:#1d6fb1; --report-bg:#f3f6fa; --report-border:#d9e3ef; --report-muted:#6b7f9f; }
    body { background:var(--report-bg); color:#102f59; }
    .report-page { width:100% !important; max-width:1120px; margin:0 auto; padding:26px 28px 52px; }
    .report-title { color:#082d60; font-size:1.55rem; font-weight:750; letter-spacing:-.02em; }
    .report-card { background:#fff; border:1px solid var(--report-border); border-radius:14px; box-shadow:0 6px 18px rgba(25,55,90,.045); overflow:hidden; }
    .report-summary { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin-bottom:18px; }
    .summary-box { background:#fff; border:1px solid var(--report-border); border-radius:12px; padding:16px 18px; }
    .summary-box span { display:block; color:var(--report-muted); font-size:.82rem; }
    .summary-box strong { display:block; margin-top:4px; color:var(--report-navy); font-size:1.45rem; }
    .report-item { padding:18px; border-bottom:1px solid #e5ebf3; }
    .report-item:last-child { border-bottom:0; }
    .report-meta { display:flex; flex-wrap:wrap; gap:8px 18px; color:var(--report-muted); font-size:.84rem; }
    .target-box { margin:12px 0; padding:13px 15px; background:#f7faff; border:1px solid #e1eaf4; border-radius:9px; }
    .target-box strong { color:#123f74; }
    .target-content { margin-top:6px; color:#445d7d; font-size:.9rem; white-space:pre-wrap; word-break:break-word; }
    .process-form { display:grid; grid-template-columns:180px 1fr auto; gap:10px; align-items:center; margin-top:12px; }
    .process-form .form-select, .process-form .form-control { min-height:40px; border-color:#cad8e8; }
    .status-pending { background:#fff3cd; color:#8a6400; }
    .status-reviewed { background:#dbeafe; color:#185b9d; }
    .status-resolved { background:#dff4e7; color:#17643a; }
    .status-dismissed { background:#e9edf2; color:#526274; }
    .empty-state { padding:64px 20px; text-align:center; color:var(--report-muted); }
    @media (max-width:767.98px) {
      .report-page { max-width:none; padding:18px 14px 38px; }
      .report-summary { grid-template-columns:1fr; }
      .process-form { grid-template-columns:1fr; }
    }
  </style>
</head>
<body>
  <%- include('../../header') %>

  <main class="container-fluid report-page">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="report-title mb-0"><i class="fas fa-flag text-danger me-2"></i>게시판 신고 관리</h2>
      <a href="/boards" class="btn btn-outline-secondary btn-sm"><i class="fas fa-arrow-left"></i> 커뮤니티</a>
    </div>

    <section class="report-summary">
      <div class="summary-box"><span>현재 조회 결과</span><strong><%= reportItems.length %>건</strong></div>
      <div class="summary-box"><span>전체 미처리 신고</span><strong class="text-danger"><%= pendingReports %>건</strong></div>
      <div class="summary-box"><span>처리 원칙</span><strong style="font-size:1rem;margin-top:10px;">확인 후 숨김·삭제</strong></div>
    </section>

    <section class="report-card mb-4">
      <div class="p-3">
        <form method="GET" class="row g-2">
          <div class="col-md-4">
            <select name="status" class="form-select">
              <option value="">모든 처리 상태</option>
              <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>미처리</option>
              <option value="reviewed" <%= status === 'reviewed' ? 'selected' : '' %>>검토중</option>
              <option value="resolved" <%= status === 'resolved' ? 'selected' : '' %>>조치 완료</option>
              <option value="dismissed" <%= status === 'dismissed' ? 'selected' : '' %>>문제없음</option>
            </select>
          </div>
          <div class="col-md-4">
            <select name="type" class="form-select">
              <option value="">게시글·댓글 전체</option>
              <option value="post" <%= type === 'post' ? 'selected' : '' %>>게시글 신고</option>
              <option value="comment" <%= type === 'comment' ? 'selected' : '' %>>댓글 신고</option>
            </select>
          </div>
          <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-primary flex-grow-1" type="submit"><i class="fas fa-filter"></i> 조회</button>
            <a href="/boards/admin/reports" class="btn btn-outline-secondary"><i class="fas fa-rotate"></i> 초기화</a>
          </div>
        </form>
      </div>
    </section>

    <section class="report-card">
      <% if (reportItems.length === 0) { %>
        <div class="empty-state">
          <i class="fas fa-check-circle fa-3x mb-3 text-success"></i>
          <h5>조건에 맞는 신고가 없습니다.</h5>
        </div>
      <% } %>

      <% reportItems.forEach(({ report, target }) => { %>
        <% const statusLabels = { pending:'미처리', reviewed:'검토중', resolved:'조치 완료', dismissed:'문제없음' }; %>
        <article class="report-item" data-report-id="<%= report._id %>">
          <div class="d-flex justify-content-between align-items-start gap-3">
            <div class="report-meta">
              <span><i class="fas fa-user"></i> 신고자: <%= report.reporterName || report.reporter?.name || report.reporter?.username || '-' %></span>
              <span><i class="fas fa-layer-group"></i> <%= report.targetType === 'post' ? '게시글' : '댓글' %></span>
              <span><i class="fas fa-clock"></i> <%= new Date(report.createdAt).toLocaleString('ko-KR') %></span>
            </div>
            <span class="badge status-<%= report.status %>"><%= statusLabels[report.status] || report.status %></span>
          </div>

          <div class="mt-3"><strong>신고 사유:</strong> <%= report.reason || '기타' %></div>
          <% if (report.description) { %><div class="text-muted small mt-1"><%= report.description %></div><% } %>

          <div class="target-box">
            <% if (target) { %>
              <strong><%= report.targetType === 'post' ? target.title : '댓글 내용' %></strong>
              <div class="target-content"><%= String(target.content || '').slice(0, 300) %><%= String(target.content || '').length > 300 ? '…' : '' %></div>
              <% if (report.targetType === 'post') { %>
                <a class="btn btn-sm btn-outline-primary mt-2" href="/boards/<%= target.boardId %>/<%= target._id %>" target="_blank">원문 확인</a>
              <% } %>
              <% if (target.isHidden) { %><span class="badge bg-secondary ms-2">현재 숨김</span><% } %>
            <% } else { %>
              <span class="text-muted"><i class="fas fa-circle-exclamation"></i> 대상이 이미 삭제되었습니다.</span>
            <% } %>
          </div>

          <% if (report.adminNote) { %>
            <div class="alert alert-light border py-2 small mb-2">
              <strong>처리 기록:</strong> <%= report.adminNote %>
              <% if (report.processedAt) { %> · <%= new Date(report.processedAt).toLocaleString('ko-KR') %><% } %>
            </div>
          <% } %>

          <form class="process-form" data-process-form>
            <select name="action" class="form-select" required>
              <option value="">처리 선택</option>
              <option value="reviewed">검토중으로 표시</option>
              <option value="dismissed">문제없음</option>
              <% if (target) { %>
                <option value="hide">대상 숨김</option>
                <option value="delete">대상 삭제</option>
              <% } %>
            </select>
            <input name="adminNote" class="form-control" maxlength="500" placeholder="처리 메모(선택)">
            <button class="btn btn-primary" type="submit">처리 저장</button>
          </form>
        </article>
      <% }); %>
    </section>

    <% if (totalPages > 1) { %>
      <nav class="mt-4" aria-label="신고 목록 페이지">
        <ul class="pagination justify-content-center">
          <% for (let i = 1; i <= totalPages; i++) { %>
            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
              <a class="page-link" href="?page=<%= i %>&status=<%= status %>&type=<%= type %>"><%= i %></a>
            </li>
          <% } %>
        </ul>
      </nav>
    <% } %>
  </main>

  <%- include('../../footer') %>
  <script>
    document.querySelectorAll('[data-process-form]').forEach(form => {
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const item = form.closest('[data-report-id]');
        const action = form.elements.action.value;
        if (!action) return;
        const messages = { hide:'신고 대상을 숨기시겠습니까?', delete:'신고 대상을 완전히 삭제하시겠습니까?', dismissed:'문제없는 신고로 처리하시겠습니까?', reviewed:'검토중으로 변경하시겠습니까?' };
        if (!confirm(messages[action])) return;
        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        try {
          const response = await fetch(`/boards/admin/reports/${item.dataset.reportId}/process`, {
            method:'POST',
            headers:{ 'Content-Type':'application/json' },
            body:JSON.stringify({ action, adminNote:form.elements.adminNote.value })
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || '처리하지 못했습니다.');
          location.reload();
        } catch (error) {
          alert(error.message);
          button.disabled = false;
        }
      });
    });
  </script>
</body>
</html>
