<%- include('header') %>
<style>
.u-page{max-width:1500px;margin:24px auto 64px;padding:0 22px;color:#172b4d;font-size:.88rem}.u-head{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:16px}.u-head h1{font-size:1.35rem;margin:0;font-weight:800}.u-card{background:#fff;border:1px solid #dbe4ef;border-radius:12px;box-shadow:0 4px 14px rgba(30,54,87,.06);padding:16px;margin-bottom:15px}.u-filter{display:grid;grid-template-columns:2fr 1fr 1fr auto auto;gap:9px}.u-filter input,.u-filter select{border:1px solid #c8d5e5;border-radius:7px;padding:8px 10px;font-size:.86rem}.u-btn{border:0;border-radius:7px;padding:8px 12px;background:#1769aa;color:#fff;text-decoration:none;font-size:.84rem;font-weight:700;display:inline-block}.u-btn.secondary{background:#f0f4f8;color:#244368}.u-table-wrap{overflow:auto}.u-table{width:100%;border-collapse:collapse;white-space:nowrap;font-size:.86rem}.u-table th,.u-table td{padding:9px 10px;border-bottom:1px solid #e7edf5;text-align:left}.u-table th{background:#f5f8fc;color:#45617f;font-size:.79rem}.u-table tr:hover td{background:#f8fbff}.u-muted{color:#72849a;font-size:.82rem}.u-empty{text-align:center;padding:34px;color:#72849a}.u-total{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:15px}.u-metric{background:#fff;border:1px solid #dbe4ef;border-radius:10px;padding:13px 15px;border-left:3px solid #1769aa}.u-metric span{font-size:.8rem}.u-metric strong{display:block;font-size:1.15rem;color:#17365d;margin-top:2px}.u-alert{padding:10px 13px;background:#eaf8ef;color:#176338;border-radius:8px;margin-bottom:14px}.u-badge{display:inline-block;padding:3px 7px;border-radius:999px;font-size:.72rem;font-weight:800}.u-badge.ok{background:#e7f7ed;color:#19713a}.u-badge.wait{background:#fff3dc;color:#9a5b00}@media(max-width:900px){.u-total{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){.u-filter,.u-total{grid-template-columns:1fr}.u-head{align-items:flex-start;flex-direction:column}}
.u-page{width:calc(100% - 48px);max-width:1280px;padding:0}
.u-order-check{width:16px;height:16px}.u-order-qty{width:76px;border:1px solid #c8d5e5;border-radius:6px;padding:6px;text-align:right}.u-order-actions{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:12px}.u-order-help{color:#64748b;font-size:.8rem}
</style>
<main class="u-page">
 <% const safeMessage=typeof message!=='undefined'?message:null; const safeView=typeof view!=='undefined'?view:'stats'; const safeAllEmployees=typeof allEmployees!=='undefined'&&Array.isArray(allEmployees)?allEmployees:[]; const safeEmployees=typeof employees!=='undefined'&&Array.isArray(employees)?employees:[]; const safeItems=typeof items!=='undefined'&&Array.isArray(items)?items:[]; const safeStats=typeof stats!=='undefined'&&Array.isArray(stats)?stats:[]; %>
 <% if(safeMessage){ %><div class="u-alert"><%= safeMessage %></div><% } %>
 <div class="u-head"><div><h1><%= safeView==='stats'?'발주 통계':'유니폼 관리' %></h1><div class="u-muted"><%= safeView==='stats'?'신청 수량과 지급 완료 수량을 비교해 실제 발주 수량을 관리합니다.':'직원별 사이즈, 신청 수량과 지급 이력을 관리합니다.' %></div></div><% if(safeView==='stats'){ %><a class="u-btn" href="/uniform/excel-qty">발주 통계 내보내기</a><% } %></div>
 <% if(safeView==='employees'){ %>
 <% const completeCount=safeAllEmployees.filter(e=>safeItems.every(i=>Boolean(e[i.key]))).length; const recentCount=safeAllEmployees.reduce((n,e)=>n+(e.uniformIssues||[]).filter(h=>Date.now()-new Date(h.issuedAt).getTime()<=30*86400000).length,0); %>
 <div class="u-total"><div class="u-metric"><span>전체 직원</span><strong><%= safeAllEmployees.length %>명</strong></div><div class="u-metric"><span>입력 완료</span><strong><%= completeCount %>명</strong></div><div class="u-metric"><span>미입력·입력 중</span><strong><%= safeAllEmployees.length-completeCount %>명</strong></div><div class="u-metric"><span>최근 30일 지급</span><strong><%= recentCount %>건</strong></div></div>
 <section class="u-card"><form class="u-filter" method="get" action="/uniform"><input name="q" value="<%= q %>" placeholder="이름 또는 사번 검색"><select name="department"><option value="">전체 부서</option><% departments.sort().forEach(d=>{ %><option value="<%= d %>" <%= department===d?'selected':'' %>><%= d %></option><% }) %></select><select name="completion"><option value="">전체 입력 상태</option><option value="complete" <%= completion==='complete'?'selected':'' %>>입력 완료</option><option value="incomplete" <%= completion==='incomplete'?'selected':'' %>>미입력·입력 중</option></select><button class="u-btn">검색</button><a class="u-btn secondary" href="/uniform">초기화</a></form></section>
 <section class="u-card u-table-wrap"><table class="u-table"><thead><tr><th>사번</th><th>이름</th><th>부서</th><th>직급</th><th>입력 품목</th><th>최근 지급일</th><th>관리</th></tr></thead><tbody>
 <% safeEmployees.forEach(e=>{ const filled=safeItems.filter(i=>e[i.key]).length; const issues=e.uniformIssues||[]; const latest=issues.length?issues.slice().sort((a,b)=>new Date(b.issuedAt)-new Date(a.issuedAt))[0]:null; %>
 <tr><td><%= e.empNo||'-' %></td><td><strong><%= e.name %></strong></td><td><%= e.department||'-' %></td><td><%= e.position||'-' %></td><td><span class="u-badge <%= filled===safeItems.length?'ok':'wait' %>"><%= filled===safeItems.length?'입력 완료':'입력 중' %></span> <%= filled %>/<%= safeItems.length %></td><td><%= latest?new Date(latest.issuedAt).toLocaleDateString('ko-KR'):'-' %></td><td><a class="u-btn secondary" href="/uniform/<%= e._id %>">조회</a> <a class="u-btn" href="/uniform/<%= e._id %>/edit">수정</a></td></tr>
 <% }) %></tbody></table><% if(!safeEmployees.length){ %><div class="u-empty">검색된 직원이 없습니다.</div><% } %></section>
 <% } else { const total=safeStats.reduce((s,r)=>s+r.quantity,0),requested=safeStats.reduce((s,r)=>s+r.requested,0),issued=safeStats.reduce((s,r)=>s+r.issued,0); %>
 <div class="u-total"><div class="u-metric"><span>신청 수량</span><strong><%= requested %></strong></div><div class="u-metric"><span>지급 완료</span><strong><%= issued %></strong></div><div class="u-metric"><span>발주 필요</span><strong><%= total %></strong></div><div class="u-metric"><span>대상 직원</span><strong><%= safeEmployees.length %>명</strong></div></div>
 <form id="uniformOrderForm" action="/uniform/order-excel" method="post"><input type="hidden" id="orderLines" name="orderLines"><section class="u-card"><div class="u-order-actions"><div><strong>발주 품목 선택</strong><div class="u-order-help">발주할 항목을 선택하고 수량을 조정한 뒤 발주서를 내보내세요.</div></div><button class="u-btn" type="submit">선택 품목 발주서 내보내기</button></div><div class="u-table-wrap"><table class="u-table"><thead><tr><th>선택</th><th>품목</th><th>사이즈</th><th>신청 수량</th><th>지급 완료</th><th>발주 필요</th><th>발주 수량</th></tr></thead><tbody><% safeStats.forEach((r,index)=>{ %><tr data-item="<%= r.item %>" data-size="<%= r.size %>"><td><input class="u-order-check" type="checkbox" <%= r.quantity>0?'checked':'disabled' %>></td><td><strong><%= r.item %></strong></td><td><%= r.size %></td><td><%= r.requested %></td><td><%= r.issued %></td><td><strong><%= r.quantity %></strong></td><td><input class="u-order-qty" type="number" min="0" max="9999" value="<%= r.quantity %>" <%= r.quantity>0?'':'disabled' %>></td></tr><% }) %></tbody></table><% if(!safeStats.length){ %><div class="u-empty">입력된 유니폼 수량이 없습니다.</div><% } %></div></section></form>
 <% } %>
</main>
<%- include('footer') %>
<script>
document.addEventListener('DOMContentLoaded',function(){
 const form=document.getElementById('uniformOrderForm');if(!form)return;
 form.addEventListener('submit',function(event){
  const lines=[];
  form.querySelectorAll('tbody tr').forEach(function(row){
   const checked=row.querySelector('.u-order-check'),qty=row.querySelector('.u-order-qty');
   if(checked&&checked.checked&&qty&&Number(qty.value)>0)lines.push({item:row.dataset.item,size:row.dataset.size,quantity:Number(qty.value)});
  });
  if(!lines.length){event.preventDefault();alert('발주할 품목을 한 개 이상 선택하세요.');return;}
  document.getElementById('orderLines').value=JSON.stringify(lines);
 });
});
</script>
