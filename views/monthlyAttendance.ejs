<%- include('header') %>

<style>
  .monthly-page { max-width: 1680px; }
  .monthly-panel { border: 1px solid #e1e8f0; border-radius: 12px; background: #fff; overflow: hidden; }
  .monthly-page .page-head h2 { font-size: 1.55rem; line-height: 1.25; }
  .monthly-page .page-head .btn { font-size: .85rem; padding: .35rem .65rem; }
  .monthly-filter { display: flex; gap: .5rem; flex-wrap: nowrap; align-items: center; }
  .monthly-filter .form-select, .monthly-filter .form-control, .monthly-filter .btn { font-size: .86rem; padding: .35rem .65rem; min-height: 36px; }
  .monthly-filter .form-select { flex: 0 0 auto; padding-right: 2.15rem; background-position: right .65rem center; }
  .monthly-filter #monthlyYear { width: 102px; }
  .monthly-filter #monthlyMonth { width: 82px; }
  .monthly-filter #monthlyDepartment { width: 152px; }
  .monthly-filter .form-control { width: 240px; min-width: 150px; flex: 0 1 240px; }
  .monthly-filter .btn { flex: 0 0 auto; }
  .monthly-toolbar { padding: .7rem .85rem; }
  .monthly-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; }
  .monthly-stat { padding: .65rem .85rem; border: 1px solid #dfe6f0; border-radius: 10px; background: #fff; }
  .monthly-stat-label { color: #617187; font-size: .76rem; }
  .monthly-stat-value { display: block; font-size: 1.18rem; font-weight: 700; margin-top: .25rem; }
  .monthly-grid { overflow: auto; max-height: 68vh; }
  .monthly-table { width: max-content; min-width: 100%; border-collapse: separate; border-spacing: 0; font-size: .82rem; }
  .monthly-table th, .monthly-table td { border-right: 1px solid #e6ebf2; border-bottom: 1px solid #e6ebf2; padding: .55rem .45rem; text-align: center; white-space: nowrap; background: #fff; }
  .monthly-table thead th { position: sticky; top: 0; z-index: 4; background: #eaf1fa; font-weight: 700; }
  .monthly-table tbody tr:hover td { background: #f4f8ff; }
  .monthly-table .staff-name { position: sticky; left: 0; z-index: 3; min-width: 132px; text-align: left; padding-left: .9rem; box-shadow: 2px 0 3px #dae2ec; }
  .monthly-table .staff-dept { position: sticky; left: 132px; z-index: 3; min-width: 108px; text-align: left; }
  .monthly-table thead .staff-name, .monthly-table thead .staff-dept { z-index: 6; background: #eaf1fa; }
  .monthly-table .day-col { min-width: 69px; }
  .monthly-table .weekend { background: #f0f6ff; color: #235e9c; }
  .monthly-table .sunday { background: #fff1f1; color: #b74c4c; }
  .monthly-table .monthly-sum { min-width: 82px; font-weight: 700; background: #eaf7f1; }
  .monthly-day { display: block; width: 100%; border: 0; border-radius: 6px; padding: .4rem .18rem; background: #e6f5eb; color: #17633c; font-size: .78rem; }
  .monthly-day:hover, .monthly-day:focus-visible { outline: 2px solid #2b69d6; outline-offset: 1px; }
  .monthly-day.special { background: #e8f0ff; color: #245bb3; }
  .monthly-day.off { background: #f1eefb; color: #6245a0; }
  .monthly-day.leave { background: #f1f3f6; color: #566272; }
  .monthly-day.warning { background: #fff1d7; color: #975600; }
  .monthly-day.absent { background: #ffe6e6; color: #ae3030; }
  .monthly-day.empty { background: transparent; color: #a5afbc; }
  .monthly-detail { border: 1px solid #dfe6f0; border-radius: 12px; background: #fff; padding: 1.1rem; position: sticky; top: 1rem; }
  .monthly-detail dl { display: grid; grid-template-columns: 100px 1fr; gap: .65rem .8rem; margin: 0; }
  .monthly-detail dt { color: #69798c; font-weight: 500; }
  .monthly-detail dd { margin: 0; overflow-wrap: anywhere; }
  @media (max-width: 992px) { .monthly-detail { position: static; margin-top: 1rem; } .monthly-filter { flex-wrap: wrap; } }
  @media (max-width: 700px) { .monthly-filter .form-control { flex: 1 1 100%; width: 100%; } .monthly-filter .btn { flex: 1 1 auto; } }
  @media (max-width: 700px) { .monthly-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } .monthly-page .page-head { align-items: flex-start !important; } }
</style>

<%
  const observedToday = new Date();
  const counts = { recorded: 0, leave: 0, missing: 0 };
  monthlyData.forEach(employee => employee.dailyAttendance.forEach(attendance => {
    const status = String(attendance.status || '').trim();
    if (status) {
      counts.recorded++;
      if (/휴가|연차|반차|병가|경조/.test(status)) counts.leave++;
    } else if (new Date(`${attendance.date}T12:00:00`) <= observedToday) counts.missing++;
  }));
%>
<div class="container-fluid monthly-page py-3">
  <div class="d-flex flex-wrap justify-content-between gap-2 align-items-center mb-3 page-head">
    <div><h2 class="mb-0"><i class="fa-solid fa-calendar-days text-primary me-2"></i>월간 근태현황</h2></div>
    <div class="d-flex flex-wrap gap-2"><a class="btn btn-outline-secondary" href="/attendance"><i class="fa-solid fa-arrow-left me-1"></i>일일 근태</a>
      <button class="btn btn-success" type="button" onclick="exportToExcel()"><i class="fa-solid fa-file-excel me-1"></i>엑셀 다운로드</button></div>
  </div>

  <div class="monthly-panel monthly-toolbar mb-3">
    <form method="GET" class="monthly-filter" id="monthlyFilters">
      <label class="visually-hidden" for="monthlyYear">연도</label><select id="monthlyYear" name="year" class="form-select" onchange="this.form.submit()">
        <% const latestYear = new Date().getFullYear(); for (let y = latestYear - 3; y <= latestYear; y++) { %>
          <option value="<%= y %>" <%= y === Number(year) ? 'selected' : '' %>><%= y %>년</option>
        <% } %>
      </select>
      <label class="visually-hidden" for="monthlyMonth">월</label><select id="monthlyMonth" name="month" class="form-select" onchange="this.form.submit()">
        <% for (let m = 1; m <= 12; m++) { %><option value="<%= m %>" <%= m === Number(month) ? 'selected' : '' %>><%= m %>월</option><% } %>
      </select>
      <label class="visually-hidden" for="monthlyDepartment">부서</label><select id="monthlyDepartment" name="department" class="form-select" onchange="this.form.submit()">
        <option value="">전체 부서</option>
        <% (allDepartments || []).forEach(dept => { %><option value="<%= dept %>" <%= dept === selectedDepartment ? 'selected' : '' %>><%= dept %></option><% }); %>
      </select>
      <label class="visually-hidden" for="monthlySearch">이름 또는 사번 검색</label><input id="monthlySearch" class="form-control" type="search" placeholder="이름 또는 사번 검색" oninput="filterMonthlyRows()">
      <button class="btn btn-primary" type="submit">조회</button>
    </form>
  </div>

  <div class="monthly-stats mb-3">
    <div class="monthly-stat"><span class="monthly-stat-label">조회 직원</span><strong class="monthly-stat-value" id="monthlyVisibleCount"><%= monthlyData.length %>명</strong></div>
    <div class="monthly-stat"><span class="monthly-stat-label">입력된 날짜 기록</span><strong class="monthly-stat-value"><%= counts.recorded %>건</strong></div>
    <div class="monthly-stat"><span class="monthly-stat-label">휴가 관련 기록</span><strong class="monthly-stat-value"><%= counts.leave %>건</strong></div>
    <div class="monthly-stat"><span class="monthly-stat-label">오늘까지 상태 미입력</span><strong class="monthly-stat-value text-warning"><%= counts.missing %>건</strong></div>
  </div>

  <div class="row g-3">
    <div class="col-lg-9">
      <div class="monthly-panel"><div class="px-3 py-2 border-bottom d-flex flex-wrap justify-content-between gap-2">
        <strong>직원별 일간 근태</strong>
      </div>
      <div class="monthly-grid"><table class="monthly-table" aria-label="직원별 월간 근태 상태">
        <thead><tr><th class="staff-name" scope="col">직원</th><th class="staff-dept" scope="col">부서</th>
          <% for (let d = 1; d <= daysInMonth; d++) {
            const date = new Date(Number(year), Number(month) - 1, d, 12);
            const weekday = date.getDay();
          %><th class="day-col <%= weekday === 0 ? 'sunday' : weekday === 6 ? 'weekend' : '' %>" scope="col"><%= d %>일 <%= ['일','월','화','수','목','금','토'][weekday] %></th><% } %>
          <th class="monthly-sum" scope="col">월 총시간</th>
        </tr></thead>
        <tbody>
        <% monthlyData.forEach(employee => {
          let total = 0;
          employee.dailyAttendance.forEach(item => { total += Number.parseFloat(item.totalTime) || 0; });
        %><tr class="monthly-employee" data-search="<%= `${employee.name} ${employee.empNo || ''}`.toLocaleLowerCase('ko-KR') %>">
          <th scope="row" class="staff-name"><span class="fw-semibold"><%= employee.name %></span><br><small class="text-muted"><%= employee.empNo || '-' %></small></th>
          <td class="staff-dept"><%= employee.department %></td>
          <% employee.dailyAttendance.forEach(item => {
            const status = String(item.status || '').trim();
            const shortStatus = status.startsWith('출근(주특)') ? '주간특근' : status.startsWith('출근(야특)') ? '야간특근' :
              status === '출근(주)' ? '주간' : status === '출근(초)' ? '초야' : status === '출근(심)' ? '심야' : status || '—';
            const kind = !status ? 'empty' : /결근|무단/.test(status) ? 'absent' : /지각|조퇴|미입력/.test(status) ? 'warning' :
              /휴무|휴일|비번/.test(status) ? 'off' : /휴가|연차|반차|병가|경조/.test(status) ? 'leave' : /특근/.test(status) ? 'special' : '';
            const weekday = new Date(`${item.date}T12:00:00`).getDay();
          %><td class="day-col <%= weekday === 0 ? 'sunday' : weekday === 6 ? 'weekend' : '' %>">
            <button type="button" class="monthly-day <%= kind %>" data-person="<%= JSON.stringify({ name: employee.name, department: employee.department, empNo: employee.empNo }) %>" data-attendance="<%= JSON.stringify(item) %>" onclick="showMonthlyDetail(this)" aria-label="<%= `${employee.name} ${item.date} ${status || '미입력'} 상세 보기` %>"><%= shortStatus %></button>
          </td><% }); %>
          <td class="monthly-sum"><%= total.toFixed(1) %>h</td>
        </tr><% }); %>
        </tbody>
      </table></div>
      <% if (!monthlyData.length) { %><div class="text-center text-muted py-4">조회된 직원이 없습니다.</div><% } %>
      <div class="px-3 py-2 border-top small text-muted">주말은 날짜 배경색으로 구분합니다. 입력된 근태 상태가 없으면 — 로 표시합니다.</div>
      </div>
    </div>
    <div class="col-lg-3"><aside class="monthly-detail" id="monthlyDetail" aria-live="polite">
      <h5 class="mb-3">근태 상세</h5><p class="text-muted mb-0">왼쪽 표에서 직원의 날짜 칸을 선택해 주세요.</p>
    </aside></div>
  </div>
</div>

<script>
  function filterMonthlyRows() {
    const query = document.getElementById('monthlySearch').value.trim().toLocaleLowerCase('ko-KR');
    let visible = 0;
    document.querySelectorAll('.monthly-employee').forEach(row => {
      const match = row.dataset.search.includes(query);
      row.hidden = !match;
      if (match) visible++;
    });
    document.getElementById('monthlyVisibleCount').textContent = `${visible}명`;
  }

  function showMonthlyDetail(button) {
    const person = JSON.parse(button.dataset.person);
    const item = JSON.parse(button.dataset.attendance);
    const detail = document.getElementById('monthlyDetail');
    detail.replaceChildren();
    const heading = document.createElement('h5');
    heading.className = 'mb-3';
    heading.textContent = '근태 상세';
    const subtitle = document.createElement('p');
    subtitle.className = 'fw-semibold mb-3';
    subtitle.textContent = `${person.name} · ${item.date} (${person.department})`;
    const list = document.createElement('dl');
    const fields = [
      ['상태', item.status || '미입력'], ['출근 · 퇴근', `${item.checkIn || '—'} ~ ${item.checkOut || '—'}`],
      ['기본 · 연장', `${item.basic || '0'}h · ${item.overtime || '0'}h`],
      ['특근 · 특연', `${item.special || '0'}h · ${item.specialOvertime || '0'}h`],
      ['야간시간', `${item.night || '0'}h`], ['총시간', `${item.totalTime || '0'}h`], ['비고', item.note || '—']
    ];
    fields.forEach(([label, value]) => {
      const term = document.createElement('dt'); term.textContent = label;
      const description = document.createElement('dd'); description.textContent = value;
      list.append(term, description);
    });
    const link = document.createElement('a');
    link.className = 'btn btn-outline-primary btn-sm mt-3';
    link.href = `/attendance?date=${encodeURIComponent(item.date)}&department=${encodeURIComponent(person.department || '')}`;
    link.textContent = '일일 근태에서 보기';
    detail.append(heading, subtitle, list, link);
    if (window.matchMedia('(max-width: 991px)').matches) detail.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function exportToExcel() {
    const params = new URLSearchParams({ year: '<%= year %>', month: '<%= month %>', department: document.getElementById('monthlyDepartment').value });
    window.location.href = `/monthlyAttendance/export?${params}`;
  }
</script>
<%- include('footer') %>
