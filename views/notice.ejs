<% if (session && session.userId) { %>
  <%- include('header') %>
<% } else { %>
  <%- include('noticeHeader') %>
<% } %>

<main class="container py-4 py-md-5 flex-grow-1">
  <div class="d-flex align-items-center mb-4">
    <h1 class="h3 fw-bold mb-0"><i class="fa-solid fa-bullhorn text-primary me-2" aria-hidden="true"></i>시스템 알림</h1>
    <% if (canManageNotices) { %>
      <a href="/notice/new" class="btn btn-primary ms-auto"><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>알림 작성</a>
    <% } %>
  </div>

  <div class="card border-0 shadow-sm overflow-hidden">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 notice-table">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-3 ps-md-4">제목</th>
              <th scope="col" class="notice-author">작성자</th>
              <th scope="col" class="notice-date pe-3 pe-md-4">작성일</th>
            </tr>
          </thead>
          <tbody>
            <% notices.forEach(function(notice) { %>
              <tr>
                <td class="ps-3 ps-md-4">
                  <a class="notice-link" href="/notice/<%= notice._id %>"><%= notice.title %></a>
                </td>
                <td class="notice-author text-muted"><%= notice.author?.username || '관리자' %></td>
                <td class="notice-date text-muted pe-3 pe-md-4"><%= notice.createdAt.toLocaleDateString('ko-KR') %></td>
              </tr>
            <% }); %>
            <% if (notices.length === 0) { %>
              <tr><td colspan="3" class="text-center text-muted py-5">등록된 시스템 알림이 없습니다.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <% if (totalPages > 1) { %>
    <nav aria-label="시스템 알림 페이지" class="mt-4">
      <ul class="pagination justify-content-center flex-wrap">
        <% for (let i = 1; i <= totalPages; i++) { %>
          <li class="page-item <%= currentPage === i ? 'active' : '' %>">
            <a class="page-link" href="/notice?page=<%= i %>" <%= currentPage === i ? 'aria-current="page"' : '' %>><%= i %></a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>
</main>

<style>
  .notice-table th { color: #475569; font-size: .87rem; font-weight: 650; padding-top: 1rem; padding-bottom: 1rem; }
  .notice-table td { padding-top: 1.05rem; padding-bottom: 1.05rem; }
  .notice-table .notice-author { width: 150px; }
  .notice-table .notice-date { width: 145px; white-space: nowrap; }
  .notice-link { color: #1e293b; font-weight: 550; text-decoration: none; }
  .notice-link:hover, .notice-link:focus-visible { color: #1d4ed8; text-decoration: underline; }
  @media (max-width: 575.98px) {
    .notice-table .notice-author { display: none; }
    .notice-table .notice-date { width: 95px; font-size: .8rem; }
  }
</style>
<%- include('footer') %>
